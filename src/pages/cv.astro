<main class="paper" id="top">
	<header class="masthead reveal">
		<p class="cover" id="cover" data-text="if you are here, likely i sent this link within my application."><span id="coverText"></span><span class="caret" aria-hidden="true"></span></p>
		<h1 class="nameplate">mehmet utku öztürk</h1>
		<p class="motto" aria-label="unpredictable, unsatisfied, unconventional.">
			<span class="word"><button class="un" type="button" tabindex="-1" aria-hidden="true" data-w="predictable">un</button><span class="rest">predictable,</span></span>
			<span class="word"><button class="un" type="button" tabindex="-1" aria-hidden="true" data-w="satisfied">un</button><span class="rest">satisfied,</span></span>
			<span class="word"><button class="un" type="button" tabindex="-1" aria-hidden="true" data-w="conventional">un</button><span class="rest">conventional.</span></span>
		</p>
	</header>

	<section class="lead reveal" aria-label="introduction">
		<div class="lead-body">
			<p class="standfirst">started programming when i was 8 with small apps and scripts. got familiar with c++ and c# by i was 11. started working on machine learning at 13, extremely unsuccessfully finetuned my first llm at 14. since then, i&rsquo;m working on software with a primary focus on artificial consciousness and &ldquo;thinking&rdquo; systems. other than software, i am interested in powerlifting, strongman, martial arts, cognitive science, kinesiology, chess, sudoku, and good coffee.</p>
			<dl class="particulars">
				<div><dt>age</dt><dd><span class="age-n" id="age">17.000000000</span><small>born 29 november 2008</small></dd></div>
				<div><dt>based</dt><dd>ankara, türkiye<small>gmt+3 · <span id="clock">--:--</span></small></dd></div>
				<div><dt>sat</dt><dd>{sat.math + sat.rw}<small>math {sat.math} · reading &amp; writing {sat.rw}</small></dd></div>
				<div><dt>focus</dt><dd>llms, neuro-symbolic ai, connectomics</dd></div>
				<div><dt>email</dt><dd>m@utku.space</dd></div>
			</dl>
		</div>
		<aside class="lead-aside">
			<figure class="fig"><div class="fig-slot"><img src={`${A}/portrait.png`} width="440" height="345" alt="engraved portrait of mehmet utku öztürk" /></div></figure>
		</aside>
	</section>

	<section id="numbers" class="section reveal">
		<div class="rule-head"><h2 class="rule-head-label">numbers</h2><span class="rule-head-note">the parts that can be counted</span></div>
		<div class="figures">
			{figures.map((f) => (
				<div class="figure"><p class="fig-n"><span data-count={f.to} data-plain={f.plain ? '' : undefined}>{f.plain ? f.to : f.to.toLocaleString('en-US')}</span></p><p class="fig-l">{f.label}</p></div>
			))}
		</div>
	</section>

	<section id="honours" class="section reveal">
		<div class="rule-head"><h2 class="rule-head-label">honours</h2><span class="rule-head-note">labels, papers, memberships</span></div>
		<div class="rows">
			{honours.map((h) => {
				const inner = (
					<>
						<span class="row-y">{h.year}</span>
						<span class="row-t">{h.title}<span class="row-n">{h.note}</span></span>
						<span class="row-a" aria-hidden="true">{h.href ? '↗' : ''}</span>
					</>
				);
				return h.href ? <a class="row" href={h.href} target="_blank" rel="noopener">{inner}</a> : <div class="row">{inner}</div>;
			})}
		</div>
	</section>

	<section id="timeline" class="section reveal">
		<div class="rule-head"><h2 class="rule-head-label">timeline</h2><span class="rule-head-note">newest first</span></div>
		<div class="rows tl">
			{timeline.map((t) => <div class="row"><span class="row-y">{t.y}</span><ul>{t.items.map((it) => <li>{it}</li>)}</ul></div>)}
		</div>
	</section>

	<section id="work" class="section reveal">
		<div class="rule-head"><h2 class="rule-head-label">(some) work</h2><span class="rule-head-note">{projects.length} projects</span></div>
