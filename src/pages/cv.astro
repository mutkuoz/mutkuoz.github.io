---
// cv.utku.space — utku.space as an application file: the same page language (fresco
// background, black on white, lowercase serif, quiet rule-heads and hairline lists),
// plus honours, numbers, a timeline, and a few easter eggs.
// everything (css, js, data) is inline and every asset loads from utku.space by absolute
// url, so the built html runs unchanged at utku.space/cv/ and, copied, at cv.utku.space.
import { papers } from '../data/research';
import { projects, categories, categoryIcon, statusLabel } from '../data/projects';
import { associations } from '../data/associations';
import { SITE, articleUrl, formatDate, getArticles } from '../lib/site';

const A = SITE;
const CANONICAL = 'https://cv.utku.space/';
const title = 'mehmet utku öztürk — unpredictable, unsatisfied, unconventional';
const description =
	'cv of mehmet utku öztürk, machine learning developer and ai researcher in ankara, türkiye: projects, research, honours, and numbers.';
const articles = await getArticles();

// project bodies link relative to utku.space; on cv.utku.space they need the full origin
const absolute = (html: string) => html.replace(/href="\//g, `href="${SITE}/`);
const cats = categories.map((key) => ({ key, icon: categoryIcon[key], items: projects.filter((p) => p.category === key) }));
const firstLink = (html: string) => (html.match(/href="([^"]+)"/) ?? [])[1];

const sat = { math: 800, rw: 710 };

const honours = [
	{ year: '2026', title: 'hukukbert, first author', note: 'journal of computational law and legal technology. the most comprehensive legal language model for turkish.', href: 'https://doi.org/10.47852/bonviewJCLLT620210346' },
	{ year: '2025 —', title: 'tübitak-backed r&d', note: 'labgpt: test result analysis for doctors, with a corpus of years of medical research.' },
	{ year: '2025', title: 'octapar, author', note: 'zenodo. balanced user grouping with attentional embeddings and the hungarian method.', href: 'https://zenodo.org/records/17360220' },
	{ year: '2024 —', title: 'bilsem, senior student & mentor', note: 'government-led program for gifted children (top 2% iq). voluntarily teaching primary schoolers robotics, ai and software.' },
	{ year: '2023–24', title: 'clade ai, co-founder', note: 'personal ai assistant. held a $21m round.' },
	{ year: '2023', title: 'etwinning national quality label', note: 'european union, etwinning. project: “particle physics and cern”.' },
	{ year: '2018', title: 'etwinning pupil quality label', note: 'european union, etwinning.' },
	{ year: 'member', title: 'mensa international', note: 'the largest and oldest high-iq society.' },
	{ year: 'member', title: 'iaail', note: 'international association for artificial intelligence and law.' }
];

const timeline = [
	{ y: '2026', items: ['co-founded turkhukuk.ai, legaltech for turkish lawyers', 'hukukbert published, first author', 'flydoom, a fruit fly connectome playing doom', '007captcha, topazius, turkic-relevance-laya'] },
	{ y: '2025', items: ['labgpt, tübitak-backed medical r&d', 'octapar, the platform and the paper'] },
	{ y: '2024', items: ['started mentoring at bilsem', '“streaming intelligence” paper, plawlabs'] },
	{ y: '2023', items: ['etwinning national quality label: “particle physics and cern”', 'co-founded clade ai', 'trstemmer on pypi'] },
	{ y: '2022', items: ['sorubot, and a first llm fine-tune'] },
	{ y: '2020', items: ['a.d.a, a deterministic personal assistant', 'shoelace, a peer-based encryption algorithm'] },
	{ y: '2019', items: ['founded ananas studios, an indie game studio'] },
	{ y: '2018', items: ['etwinning pupil quality label'] },
	{ y: '2008', items: ['born, 29 november'] }
];

const figures = [
	{ to: sat.math + sat.rw, plain: true, label: `sat. math ${sat.math}, reading & writing ${sat.rw}` },
	{ to: projects.length, label: 'projects: open source, work, and unpublished' },
	{ to: papers.length, label: 'papers, one in a peer-reviewed journal' },
	{ to: 139255, label: 'fruit fly neurons wired into doom' },
	{ to: 14244, label: 'wikipedia articles a model of mine sorted as core turkic heritage' },
	{ to: 8, label: 'my age when i wrote my first program' }
];

// what the terminal knows
const cvData = {
	email: 'm@utku.space',
	sat,
	projects: projects.map((p) => ({ name: p.name, category: p.category, status: statusLabel[p.status], role: p.role, link: firstLink(absolute(p.body)) })),
	papers: papers.map((p) => ({ name: p.name, year: p.year, venue: p.journal ?? p.venue, link: p.links[0]?.url })),
	honours: honours.map((h) => `${h.year} · ${h.title}`)
};
const json = JSON.stringify(cvData).replace(/</g, '\\u003c');

const head = `
@font-face { font-family: 'Newsreader'; font-style: normal; font-weight: 400 600; font-display: swap; src: url('${A}/fonts/newsreader-normal-latin.woff2') format('woff2'); }
@font-face { font-family: 'Newsreader'; font-style: italic; font-weight: 400 500; font-display: swap; src: url('${A}/fonts/newsreader-italic-latin.woff2') format('woff2'); }
@font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 500 800; font-display: swap; src: url('${A}/fonts/playfair-display-normal-latin.woff2') format('woff2'); }
@font-face { font-family: 'Playfair Display'; font-style: italic; font-weight: 500 600; font-display: swap; src: url('${A}/fonts/playfair-display-italic-latin.woff2') format('woff2'); }
.page-bg { background-image: url('${A}/utku-bg.png'); background-image: image-set(url('${A}/utku-bg.webp') type('image/webp'), url('${A}/utku-bg.png') type('image/png')); }`;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<!-- an application file, not a search result: kept out of indexes on purpose -->
	<meta name="robots" content="noindex, follow" />
	<link rel="canonical" href={CANONICAL} />
	<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
	<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
	<link rel="icon" type="image/svg+xml" href={`${A}/favicon.svg`} />
	<link rel="preload" as="image" href={`${A}/utku-bg.webp`} type="image/webp" fetchpriority="high" />
	<link rel="preload" as="font" type="font/woff2" crossorigin href={`${A}/fonts/newsreader-normal-latin.woff2`} />
	<meta property="og:type" content="profile" />
	<meta property="og:url" content={CANONICAL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={`${A}/portrait.png`} />
	<style is:inline set:html={head}></style>
	<style is:inline>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
	--serif:   'Newsreader', Georgia, 'Times New Roman', serif;
	--display: 'Playfair Display', Georgia, 'Times New Roman', serif;
	--mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
	--ease: cubic-bezier(0.4, 0, 0.2, 1);
}
/* ── pure black / white, exactly as on utku.space ── */
[data-theme="light"] {
	--bg:#ffffff; --fg:#000000;
	--fg2:rgba(0,0,0,0.74); --muted:rgba(0,0,0,0.52); --muted2:rgba(0,0,0,0.36);
	--hair:rgba(0,0,0,0.16);
	--bg-art-opacity: 1; --bg-art-filter: none;
}
[data-theme="dark"] {
	--bg:#000000; --fg:#ffffff;
	--fg2:rgba(255,255,255,0.78); --muted:rgba(255,255,255,0.54); --muted2:rgba(255,255,255,0.38);
	--hair:rgba(255,255,255,0.20);
	--bg-art-opacity: 1; --bg-art-filter: grayscale(1) brightness(0.13) contrast(1.2);
}
/* konami: red instead of black, everywhere */
[data-konami][data-theme="light"] { --fg:#d3101c; --fg2:rgba(211,16,28,0.82); --muted:rgba(211,16,28,0.62); --muted2:rgba(211,16,28,0.42); --hair:rgba(211,16,28,0.24); --bg-art-filter: url(#redInk); }
[data-konami][data-theme="dark"] { --bg:#d3101c; --fg2:rgba(255,255,255,0.86); --muted:rgba(255,255,255,0.66); --muted2:rgba(255,255,255,0.46); --hair:rgba(255,255,255,0.3); --bg-art-opacity: 0.9; --bg-art-filter: grayscale(1) brightness(0.13) contrast(1.2) url(#redInk); }
[data-konami] img { filter: url(#redInk); }
[data-konami][data-theme="dark"] .assoc-fig img { filter: brightness(0.86) contrast(1.05) url(#redInk); }

html { scroll-behavior: smooth; background: var(--bg); transition: background-color 0.35s ease; }
body {
	font-family: var(--serif); font-optical-sizing: auto; text-transform: lowercase;
	color: var(--fg); background: transparent; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
	transition: color 0.35s ease; min-height: 100vh; line-height: 1.5;
}
::selection { background: var(--fg); color: var(--bg); }
button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; text-transform: inherit; text-align: inherit; }

/* ── fixed background artwork ── */
.page-bg {
	position: fixed; inset: 0; z-index: 0; pointer-events: none;
	background-position: center center; background-repeat: no-repeat; background-size: cover; background-attachment: fixed;
	opacity: var(--bg-art-opacity); filter: var(--bg-art-filter); transition: opacity 0.35s ease, filter 0.35s ease;
}
@supports (-webkit-touch-callout: none) { .page-bg { background-attachment: scroll; } }

#scrollProgress { position: fixed; top: 0; left: 0; height: 2px; width: 100%; transform-origin: 0 50%; transform: scaleX(0); background: var(--fg); z-index: 200; opacity: 0.6; }

/* ── navbar ── */
#navbar {
	position: fixed; top: 0; left: 0; right: 0; z-index: 100;
	display: flex; align-items: center; gap: 1rem; height: 3.4rem; padding: 0 1.3rem;
	background: color-mix(in srgb, var(--bg) 86%, transparent);
	backdrop-filter: blur(7px); -webkit-backdrop-filter: blur(7px);
	border-bottom: 1px solid var(--hair); transition: background 0.35s ease, border-color 0.35s ease;
}
@media (min-width: 720px) { #navbar { padding: 0 2rem; } }
.nav-brand { font-family: var(--display); font-style: italic; font-weight: 600; font-size: 1.02rem; color: var(--fg); text-decoration: none; white-space: nowrap; }
.nav-sub { font-style: italic; font-size: 0.86rem; color: var(--muted); margin-left: -0.5rem; white-space: nowrap; }
.nav-links { display: none; gap: 1.6rem; margin-left: auto; margin-right: 1.3rem; }
@media (min-width: 1040px) { .nav-links { display: flex; } }
@media (max-width: 1039px) { .mode-toggle { margin-left: auto; } }
.nav-link { font-size: 0.86rem; letter-spacing: 0.02em; color: var(--muted); text-decoration: none; position: relative; padding-bottom: 2px; transition: color 0.18s ease; }
.nav-link::after { content: ''; position: absolute; left: 0; right: 100%; bottom: 0; height: 1px; background: var(--fg); transition: right 0.25s var(--ease); }
.nav-link:hover { color: var(--fg); }
.nav-link:hover::after { right: 0; }
.mode-toggle {
	display: flex; align-items: center; justify-content: center; flex: none;
	width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--hair); color: var(--fg);
	transition: border-color 0.2s ease, transform 0.4s cubic-bezier(0.34,1.4,0.64,1);
}
.mode-toggle:hover { border-color: var(--fg); transform: rotate(-22deg); }
button:focus-visible, a:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }
.mode-toggle svg { width: 0.95rem; height: 0.95rem; }
[data-theme="light"] .icon-moon { display: none; }
[data-theme="dark"] .icon-sun { display: none; }

/* ── page column ── */
.paper { position: relative; z-index: 1; max-width: 80rem; margin: 0 auto; padding: 6rem 1.3rem 4rem; }
@media (min-width: 720px) { .paper { padding: 7rem 2.4rem 5rem; } }
.section { scroll-margin-top: 4.5rem; margin-top: 3.4rem; }

/* ── masthead ── */
.masthead { border-bottom: 1px solid var(--hair); padding-bottom: 1.2rem; text-align: center; }
.cover { min-height: 1.5em; margin-bottom: 0.9rem; font-style: italic; font-size: 0.9rem; color: var(--muted); }
.caret { display: inline-block; width: 1px; height: 1em; margin-left: 2px; vertical-align: -0.12em; background: var(--fg); animation: blink 1s steps(1) infinite; }
.cover.done .caret { animation: blink 1s steps(1) 4 forwards; }
@keyframes blink { 0% { opacity: 1; } 50%, 100% { opacity: 0; } }
.nameplate { font-family: var(--display); font-weight: 700; font-size: clamp(1.8rem, 4.2vw, 2.8rem); line-height: 1.05; letter-spacing: -0.02em; }
.motto { margin-top: 0.55rem; font-family: var(--display); font-style: italic; font-weight: 500; font-size: clamp(1rem, 1.9vw, 1.3rem); color: var(--fg2); }
.word { display: inline-block; }
/* the “un” is set upright: the only hint that it comes off */
.un { font-style: normal; display: inline-block; transition: transform 0.25s var(--ease); }
.un:hover { transform: translateY(-2px); }
.word.off .un { animation: unfall 1.4s var(--ease) forwards; }
.word.off .rest { text-decoration: line-through; text-decoration-thickness: 1px; }
@keyframes unfall { 30% { transform: translate(-0.1em, 0.4em) rotate(-25deg); opacity: 0.8; } 60% { transform: translate(-0.2em, 1.4em) rotate(-70deg); opacity: 0; } 61% { transform: translateY(-0.6em); opacity: 0; } 100% { transform: none; opacity: 1; } }

/* ── lead: standfirst, particulars, portrait ── */
.lead { display: grid; grid-template-columns: 1fr; gap: 2rem; margin-top: 2.2rem; }
@media (min-width: 840px) {
	.lead { grid-template-columns: 1.5fr 1fr; gap: 1.5rem; align-items: start; }
	.lead-aside .fig { margin-left: -2rem; margin-right: -1rem; max-width: 30rem; }
}
.standfirst { font-size: clamp(1.15rem, 1.7vw, 1.5rem); line-height: 1.8; text-align: justify; hyphens: auto; }
.particulars { margin-top: 1.8rem; }
.particulars div { display: grid; grid-template-columns: 6rem 1fr; align-items: baseline; gap: 1rem; padding: 0.7rem 0; border-top: 1px solid var(--hair); }
.particulars div:last-child { border-bottom: 1px solid var(--hair); }
.particulars dt { font-size: 0.74rem; letter-spacing: 0.03em; color: var(--muted); }
.particulars dd { font-size: 1rem; font-weight: 500; }
.particulars dd small { font-size: 0.8rem; font-weight: 400; font-style: italic; color: var(--muted); margin-left: 0.5rem; }
.age-n { font-variant-numeric: lining-nums tabular-nums; }
@media (max-width: 839px) { .lead-aside { display: none; } }
@media (max-width: 520px) { .particulars dd small { display: block; margin: 0.1rem 0 0; } }
.fig { margin: 0 auto; max-width: 22rem; }
.fig-slot { position: relative; isolation: isolate; }
.fig-slot img { display: block; width: 100%; height: auto; }
.fig-slot::before {
	content: ''; position: absolute; inset: -10% -12% 0; z-index: -1; pointer-events: none;
	background: radial-gradient(ellipse 50% 60% at 50% 66%, rgba(246,243,236,0.95) 0%, rgba(246,243,236,0.9) 22%, rgba(246,243,236,0.74) 38%, rgba(246,243,236,0.52) 52%, rgba(246,243,236,0.32) 65%, rgba(246,243,236,0.16) 77%, rgba(246,243,236,0.06) 88%, transparent 100%);
	-webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent 100%); mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
	opacity: 0; transition: opacity 0.35s ease;
}
[data-theme="dark"] .fig-slot::before { opacity: 1; }

/* ── quiet rule-heads ── */
.rule-head { margin-bottom: 1.4rem; padding-bottom: 0.45rem; border-bottom: 1px solid var(--hair); display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
.rule-head-label { font-size: 1rem; font-weight: 600; letter-spacing: 0.01em; }
.rule-head-note { font-style: italic; font-size: 0.85rem; font-weight: 400; color: var(--muted); }

/* ── numbers ── */
.figures { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.figure { padding: 1.1rem 1.2rem 1.2rem; border-top: 1px solid var(--hair); border-left: 1px solid var(--hair); }
.figure:nth-child(3n+1) { padding-left: 0; border-left: 0; }
.figure:nth-child(-n+3) { border-top: 0; padding-top: 0.3rem; }
.fig-n { font-family: var(--display); font-weight: 700; font-size: clamp(2rem, 3.6vw, 3rem); line-height: 1.05; letter-spacing: -0.02em; font-variant-numeric: lining-nums tabular-nums; }
.fig-l { margin-top: 0.35rem; font-size: 0.9rem; color: var(--fg2); max-width: 20rem; }
@media (max-width: 760px) {
	.figures { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.figure, .figure:nth-child(3n+1), .figure:nth-child(-n+3) { padding: 1rem 0.8rem 1rem 0; border-left: 0; border-top: 1px solid var(--hair); }
	.figure:nth-child(even) { padding-left: 1rem; border-left: 1px solid var(--hair); }
	.figure:nth-child(-n+2) { border-top: 0; padding-top: 0.3rem; }
}

/* ── hairline rows: honours, timeline, research ── */
.rows { border-bottom: 1px solid var(--hair); }
.row { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr) 1.4rem; gap: 0.3rem 1.5rem; align-items: baseline; padding: 0.95rem 0; border-top: 1px solid var(--hair); color: var(--fg); text-decoration: none; transition: padding-left 0.25s var(--ease); }
.row:first-child { border-top: 0; }
a.row:hover { padding-left: 0.4rem; }
.row-y { font-size: 0.74rem; letter-spacing: 0.03em; color: var(--muted); }
.row-t { font-family: var(--display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.01em; line-height: 1.34; }
.row-n { display: block; font-family: var(--serif); font-weight: 400; font-size: 0.92rem; letter-spacing: 0; color: var(--fg2); margin-top: 0.15rem; }
.row-a { color: var(--muted); text-align: right; transition: transform 0.18s ease, color 0.18s ease; }
a.row:hover .row-a { color: var(--fg); transform: translate(0.15rem, -0.1rem); }
.tl .row { grid-template-columns: 6.5rem minmax(0, 1fr); }
.tl .row-y { font-family: var(--display); font-style: italic; font-weight: 600; font-size: 1.25rem; letter-spacing: 0; color: var(--fg); }
.tl ul { list-style: none; display: grid; gap: 0.2rem; }
.tl li { font-size: 1rem; color: var(--fg2); }
@media (max-width: 620px) {
	.row { grid-template-columns: minmax(0, 1fr) 1.2rem; }
	.row-y { grid-column: 1 / -1; }
	.tl .row { grid-template-columns: 1fr; gap: 0.2rem; }
}

/* ── projects: three columns, descriptions shown ── */
.work-cols { display: grid; grid-template-columns: 1fr; gap: 2.2rem; }
@media (min-width: 900px) { .work-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 2.6rem; } }
.work-cat { display: flex; align-items: baseline; gap: 0.45rem; padding-bottom: 0.4rem; font-style: italic; font-weight: 500; font-size: 0.95rem; color: var(--muted); border-bottom: 1px solid var(--hair); }
.work-cat svg { flex: none; width: 1.05rem; height: 1.05rem; align-self: center; color: var(--fg); }
.work-count { font-style: normal; font-size: 0.72rem; color: var(--muted2); }
.proj { padding: 0.95rem 0 0.4rem; border-top: 1px solid var(--hair); }
.work-cat + .proj { border-top: 0; }
.proj-t { display: flex; align-items: baseline; gap: 0.5rem; font-family: var(--display); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.01em; line-height: 1.34; }
.proj-b { font-size: 0.74rem; letter-spacing: 0.02em; color: var(--muted); margin-top: 0.25rem; }
.proj-d p { margin-top: 0.5rem; font-size: 0.93rem; line-height: 1.75; color: var(--fg2); }
.status { display: inline-block; width: 0.6rem; height: 0.6rem; flex-shrink: 0; transform: translateY(-0.04em); }
.status-live { background: var(--fg); }
.status-paused { box-shadow: inset 0 0 0 1.5px var(--fg); }
.status-shelved { background: var(--muted2); }
.chip { display: inline-block; margin-right: 0.6rem; font-size: 0.78rem; letter-spacing: 0.02em; color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--fg); padding-bottom: 1px; transition: opacity 0.18s ease; }
.chip:hover { opacity: 0.55; }
.legend { margin-top: 1.4rem; font-size: 0.8rem; color: var(--muted); display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; }

/* ── research ── */
.paper-row { padding: 1rem 0; border-top: 1px solid var(--hair); }
.paper-row:first-child { border-top: 0; }
.paper-t { font-style: italic; font-weight: 500; font-size: 1.08rem; line-height: 1.4; }
.paper-b { font-size: 0.74rem; letter-spacing: 0.02em; color: var(--muted); margin-top: 0.25rem; }
.paper-row .chip, .paper-row .ghost-link { margin-top: 0.6rem; }
.paper-s { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.75; color: var(--fg2); max-width: 60rem; }
.ghost-link { font-size: 0.78rem; letter-spacing: 0.02em; color: var(--fg); border-bottom: 1px solid var(--hair); padding-bottom: 1px; transition: border-color 0.18s ease; }
.ghost-link:hover { border-color: var(--fg); }
.abs { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.32s var(--ease); }
.abs > div { overflow: hidden; min-height: 0; }
.abs.open { grid-template-rows: 1fr; }
.abs p { padding: 0.4rem 0; font-size: 0.95rem; line-height: 1.8; color: var(--fg2); text-align: justify; hyphens: auto; max-width: 64rem; }

/* ── articles ── */
.article-list { border-bottom: 1px solid var(--hair); }
.article-row { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 0.8rem 1.5rem; padding: 1.25rem 2.4rem 1.25rem 0; border-top: 1px solid var(--hair); color: var(--fg); text-decoration: none; transition: padding-left 0.25s var(--ease); }
.article-row:first-child { border-top: 0; }
.article-row:hover { padding-left: 0.45rem; }
.article-copy h3 { font-family: var(--display); font-size: clamp(1.25rem, 2vw, 1.65rem); font-style: italic; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; }
.article-copy p { max-width: 47rem; margin-top: 0.4rem; color: var(--fg2); font-size: 0.94rem; line-height: 1.6; }
.article-details { display: flex; flex-direction: column; align-items: flex-end; gap: 0.2rem; padding-top: 0.15rem; color: var(--muted); font-size: 0.74rem; letter-spacing: 0.025em; white-space: nowrap; }
.article-arrow { position: absolute; top: 50%; right: 0; color: var(--muted); transform: translateY(-50%); transition: color 0.18s ease, transform 0.18s ease; }
.article-row:hover .article-arrow { color: var(--fg); transform: translate(0.15rem, -50%); }
@media (max-width: 620px) { .article-row { grid-template-columns: 1fr; } .article-details { flex-direction: row; gap: 0.6rem; } }

/* ── associations ── */
.assoc-list { border-bottom: 1px solid var(--hair); }
.assoc-row { display: grid; grid-template-columns: 2.6rem minmax(0, 1fr) auto; align-items: center; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--hair); color: var(--fg); text-decoration: none; transition: padding-left 0.25s var(--ease); }
.assoc-row:first-child { border-top: 0; }
.assoc-row:hover { padding-left: 0.4rem; }
.assoc-logo { display: flex; align-items: center; justify-content: center; width: 2.6rem; height: 2.6rem; }
.assoc-logo svg, .assoc-logo img { display: block; width: 100%; height: 100%; object-fit: contain; }
.assoc-name { display: block; font-family: var(--display); font-weight: 700; font-size: 1.2rem; letter-spacing: -0.01em; line-height: 1.34; }
.assoc-desc { display: block; font-size: 0.9rem; color: var(--fg2); }
.assoc-role { display: block; font-size: 0.74rem; letter-spacing: 0.02em; color: var(--muted); margin-top: 0.2rem; }
.assoc-arrow { color: var(--muted); }
.assoc-wrap { display: grid; grid-template-columns: 1fr; gap: 1.6rem; }
.assoc-fig img { display: block; width: 100%; height: auto; border: 1px solid var(--hair); }
@media (min-width: 840px) { .assoc-wrap { grid-template-columns: 1fr 1fr; gap: 3rem; align-items: stretch; } .assoc-fig { position: relative; min-height: 18rem; } .assoc-fig img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; } }
[data-theme="dark"] .assoc-fig img { filter: brightness(0.86) contrast(1.05); border-color: transparent; }

/* ── off the clock ── */
.clock-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: baseline; padding: 0.9rem 0; border-top: 1px solid var(--hair); }
.clock-row:first-child { border-top: 0; }
.clock-t { display: block; font-family: var(--display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.01em; }
.clock-n { display: block; font-size: 0.9rem; color: var(--fg2); }
.clock-out { display: block; font-size: 0.85rem; font-style: italic; color: var(--muted); font-variant-numeric: tabular-nums; white-space: pre; overflow: hidden; text-overflow: ellipsis; }
.clock-out:empty { display: none; }
.clock-a { white-space: nowrap; }

/* ── contact ── */
.contact-intro { font-size: 1.15rem; line-height: 1.6; max-width: 36rem; }
.contact-loc { margin-top: 0.5rem; margin-bottom: 1.6rem; font-size: 0.74rem; letter-spacing: 0.04em; color: var(--muted); }
.c-link { display: grid; grid-template-columns: 6rem 1fr; align-items: baseline; gap: 1rem; padding: 0.85rem 0; border-top: 1px solid var(--hair); text-decoration: none; color: var(--fg); width: 100%; transition: padding-left 0.25s var(--ease); }
.c-link:last-child { border-bottom: 1px solid var(--hair); }
.c-link:hover { padding-left: 0.5rem; }
.c-link dt, .c-link .dt { font-size: 0.74rem; letter-spacing: 0.03em; color: var(--muted); }
.c-link dd, .c-link .dd { font-size: 1rem; font-weight: 500; overflow-wrap: anywhere; }
.c-link:hover dd, .c-link:hover .dd-v { text-decoration: underline; text-underline-offset: 3px; }
.c-hint { font-style: italic; font-weight: 400; font-size: 0.8rem; color: var(--muted); margin-left: 0.4rem; }

/* ── colophon ── */
.colophon { margin-top: 4rem; padding-top: 1.1rem; border-top: 1px solid var(--hair); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.6rem 1.4rem; }
.colophon-line { font-style: italic; font-size: 0.82rem; color: var(--muted); }
.colophon-links { display: flex; gap: 1.2rem; }

/* ── reveal on scroll ── */
.reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
.reveal.visible { opacity: 1; transform: none; }

/* ── toast ── */
.toast { position: fixed; left: 50%; bottom: 2rem; transform: translateX(-50%) translateY(1.5rem); z-index: 450; padding: 0.55rem 1.1rem; max-width: min(92vw, 34rem);
	background: var(--fg); color: var(--bg); font-size: 0.8rem; font-style: italic; text-align: center;
	opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.34,1.4,0.64,1), visibility 0s 0.3s; }
.toast.show { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.34,1.4,0.64,1); }

/* ── terminal: a quiet panel in the page's own colours ── */
.term { position: fixed; left: 50%; bottom: 0; z-index: 420; width: min(760px, 100vw); height: min(55vh, 440px);
	transform: translate(-50%, 100%); visibility: hidden;
	background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
	border: 1px solid var(--hair); border-bottom: 0; display: flex; flex-direction: column; text-transform: none;
	font-family: var(--mono); font-size: 0.78rem; color: var(--fg); transition: transform 0.35s var(--ease), visibility 0s 0.35s; }
.term.open { transform: translate(-50%, 0); visibility: visible; transition: transform 0.35s var(--ease); }
.term-h { display: flex; justify-content: space-between; padding: 0.5rem 0.9rem; border-bottom: 1px solid var(--hair); font-family: var(--serif); font-style: italic; font-size: 0.8rem; color: var(--muted); text-transform: lowercase; }
.term-out { flex: 1; overflow-y: auto; padding: 0.8rem 0.9rem 0; white-space: pre-wrap; word-break: break-word; line-height: 1.6; }
.term-out .m { color: var(--muted); }
.term-out a { color: var(--fg); }
.term-in { display: flex; gap: 0.5rem; padding: 0.55rem 0.9rem 0.85rem; }
.term-in input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--fg); font: inherit; }

/* ── sudoku overlay ── */
.modal { position: fixed; inset: 0; z-index: 430; display: grid; place-items: center; padding: 1rem; background: color-mix(in srgb, var(--bg) 93%, transparent); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
.modal[hidden] { display: none; }
.modal-box { text-align: center; }
.modal-box h3 { font-family: var(--display); font-weight: 700; font-size: 1.6rem; }
.modal-box p { font-style: italic; font-size: 0.85rem; color: var(--muted); margin-top: 0.3rem; }
.sdk { margin: 1.2rem auto 0.6rem; display: grid; grid-template-columns: repeat(4, 1fr); width: 14rem; aspect-ratio: 1; border: 1.5px solid var(--fg); background: var(--bg); }
.sdk button { font-family: var(--display); font-weight: 700; font-size: 1.7rem; text-align: center; border: 0.5px solid var(--hair); }
.sdk button:nth-child(4n+2) { border-right: 1.5px solid var(--fg); }
.sdk button:nth-child(n+5):nth-child(-n+8) { border-bottom: 1.5px solid var(--fg); }
.sdk button.given { color: var(--muted); cursor: default; }
.sdk.won button { background: var(--fg); color: var(--bg); transition: background 0.3s calc(var(--i) * 40ms), color 0.3s calc(var(--i) * 40ms); }

/* ── the fly ── */
.fly { position: fixed; left: 0; top: 0; z-index: 410; width: 26px; height: 26px; margin: -13px 0 0 -13px; padding: 0; color: var(--fg); }
.fly svg { width: 100%; height: 100%; display: block; overflow: visible; }
.fly .w { transform-origin: 15px 13px; animation: buzz 0.06s linear infinite alternate; opacity: 0.45; }
@keyframes buzz { to { transform: scaleY(0.4); } }
.fly.caught svg { animation: squash 0.6s var(--ease) forwards; }
@keyframes squash { 30% { transform: scale(1.4, 0.5); } 100% { transform: scale(0); opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
	*, *::before, *::after { animation-duration: 0.001s !important; animation-iteration-count: 1 !important; transition-duration: 0.001s !important; }
	html { scroll-behavior: auto; }
	.reveal { opacity: 1; transform: none; }
}
@media print {
	@page { margin: 14mm; }
	html { background: #fff; }
	.page-bg, #navbar, #scrollProgress, .toast, .term, .modal, .fly, #beyond, .colophon, .ghost-link { display: none !important; }
	body { color: #000; font-size: 10.5pt; }
	.paper { padding: 0; max-width: none; }
	.reveal { opacity: 1 !important; transform: none !important; }
	.section { margin-top: 1.6rem; }
	.proj, .row, .paper-row, .assoc-row, .figure { break-inside: avoid; }
	.assoc-fig { display: none; }
}
	</style>
</head>
