<script type="application/json" id="cvData" set:html={json}></script>
<script is:inline>
(function () {
	const $ = (s, r) => (r || document).querySelector(s);
	const $$ = (s, r) => [...(r || document).querySelectorAll(s)];
	const data = JSON.parse($('#cvData').textContent);
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const store = { get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} } };

	/* ── toast ── */
	const toastEl = $('#toast'); let toastT = 0;
	function toast(html, ms) { toastEl.innerHTML = html; toastEl.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(() => toastEl.classList.remove('show'), ms || 2800); }

	/* ── easter eggs: eight of them, remembered per browser ── */
	const EGGS = { terminal: 'opened the terminal', fly: 'caught the fly', konami: 'konami code', sudoku: 'solved the sudoku', lift: 'hit a pr', un: 'took the “un” off', hire: 'tried to hire me', end: 'read to the very end' };
	const found = new Set((store.get('cvEggs') || '').split(',').filter((k) => k in EGGS));
	function paintEggs() {
		$('#eggCount').textContent = found.size;
		$('#badge').textContent = '🥚 ' + found.size + '/8';
		$('#badge').classList.toggle('show', found.size > 0);
		$('#eggList').innerHTML = Object.keys(EGGS).map((k) => found.has(k) ? '<span class="got">' + EGGS[k] + '</span>' : '<span>???</span>').join('');
	}
	function egg(k) {
		if (found.has(k)) return false;
		found.add(k); store.set('cvEggs', [...found].join(',')); paintEggs();
		setTimeout(() => toast('<b>easter egg ' + found.size + '/8</b> · ' + EGGS[k] + (found.size === 8 ? ' — all of them. i’m impressed.' : '')), 400);
		return true;
	}
	paintEggs();

	/* ── live age: integer flips at midnight, 29 november, istanbul time ── */
	// istanbul was utc+2 in winter until 2016, utc+3 since
	const bday = (y) => Date.UTC(y, 10, 29) - (y <= 2015 ? 2 : 3) * 3600e3;
	function age(now) {
		let y = new Date(now).getUTCFullYear(), last = bday(y);
		if (now < last) last = bday(--y);
		return (y - 2008) + (now - last) / (bday(y + 1) - last);
	}
	const ageEl = $('#age'), cardAge = $('#cardAge');
	(function tick() {
		const a = age(Date.now());
		ageEl.textContent = a.toFixed(9); cardAge.textContent = a.toFixed(4);
		requestAnimationFrame(tick);
	})();
	// on the day itself
	const ist = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Istanbul', day: '2-digit', month: '2-digit' }).format(new Date());
	if (ist === '29/11') setTimeout(() => toast('<b>it’s my birthday today.</b> impeccable timing.', 5000), 3500);

	/* ── ankara clock ── */
	const clock = $('#clock'), fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Istanbul', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
	setInterval(() => { clock.textContent = fmt.format(new Date()); }, 1000); clock.textContent = fmt.format(new Date());

	/* ── cover line types itself, then the title rises ── */
	const hero = $('.hero'), cover = $('#cover'), coverText = $('#coverText'), line = cover.dataset.text;
	if (reduce) { coverText.textContent = line; hero.classList.add('go'); }
	else {
		let i = 0;
		(function type() {
			coverText.textContent = line.slice(0, ++i);
			if (i === 22) hero.classList.add('go');
			if (i < line.length) setTimeout(type, line[i - 1] === ',' ? 260 : 22 + Math.random() * 30);
		})();
	}

	/* ── “un” comes off, the word gets struck, then it snaps back ── */
	$$('.un-pre').forEach((b) => b.addEventListener('click', () => {
		const row = b.closest('.un-row'); if (row.classList.contains('off')) return;
		row.classList.add('off');
		const lines = { predictable: 'predictable? no.', satisfied: 'satisfied? not yet.', conventional: 'conventional? never.' };
		toast(lines[b.dataset.w]);
		egg('un');
		setTimeout(() => row.classList.remove('off'), 1500);
	}));

	/* ── id card: tilts with the pointer, flips on click ── */
	const card = $('#card');
	if (!reduce && matchMedia('(hover: hover)').matches) {
		const zone = $('.hero-right');
		zone.addEventListener('pointermove', (e) => {
			const r = card.getBoundingClientRect(), x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
			card.classList.add('tilting');
			card.style.setProperty('--ry', ((x - 0.5) * 22).toFixed(2) + 'deg');
			card.style.setProperty('--rx', ((0.5 - y) * 18).toFixed(2) + 'deg');
			card.style.setProperty('--mx', (x * 100).toFixed(1) + '%');
			card.style.setProperty('--my', (y * 100).toFixed(1) + '%');
		});
		zone.addEventListener('pointerleave', () => { card.classList.remove('tilting'); card.style.setProperty('--rx', '0deg'); card.style.setProperty('--ry', '0deg'); });
	}
	const flip = () => { card.classList.remove('tilting'); card.classList.toggle('flipped'); };
	card.addEventListener('click', flip);
	card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); flip(); } });

	/* ── scroll: progress bar, side index, timeline line ── */
	const prog = $('#prog'), tl = $('#tl'), tlLine = $('.tl-line'), years = $$('.ty');
	function onScroll() {
		document.body.classList.toggle('past-hero', scrollY > innerHeight * 0.8);
		const h = document.documentElement.scrollHeight - innerHeight;
		prog.style.transform = 'scaleX(' + (h > 0 ? scrollY / h : 0) + ')';
		const r = tl.getBoundingClientRect(), p = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
		tlLine.style.setProperty('--p', p.toFixed(4));
		years.forEach((y) => y.classList.toggle('lit', y.getBoundingClientRect().top < innerHeight * 0.6));
	}
	addEventListener('scroll', onScroll, { passive: true }); onScroll();
	const idx = $$('.index a');
	const secObs = new IntersectionObserver((es) => es.forEach((e) => {
		if (!e.isIntersecting) return;
		idx.forEach((a) => a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id));
		$$('.sh-n').forEach((n) => n.classList.toggle('lit', n.closest('section') === e.target));
	}), { rootMargin: '-45% 0px -50% 0px' });
	$$('main > section[id]').forEach((s) => secObs.observe(s));

	/* ── reveals, counters, scrambled headings ── */
	function count(el) {
		const to = +el.dataset.count, t0 = performance.now(), dur = reduce ? 1 : 1500;
		(function step(t) {
			const k = Math.min(1, (t - t0) / dur), v = Math.round(to * (1 - Math.pow(1 - k, 3)));
			el.textContent = 'plain' in el.dataset ? String(v) : v.toLocaleString('en-US');
			if (k < 1) requestAnimationFrame(step);
		})(t0);
	}
	const GLYPHS = '!<>-_\\/[]{}—=+*^?#01';
	function scramble(el) {
		const final = el.textContent, n = final.length; let f = 0;
		if (reduce) return;
		(function step() {
			el.textContent = [...final].map((c, i) => (c === ' ' || i < f / 2) ? c : GLYPHS[(Math.random() * GLYPHS.length) | 0]).join('');
			if (f++ < n * 2) requestAnimationFrame(step); else el.textContent = final;
		})();
	}
	const io = new IntersectionObserver((es) => es.forEach((e) => {
		if (!e.isIntersecting) return;
		const el = e.target; io.unobserve(el);
		el.classList.add('in');
		$$('[data-count]', el).forEach(count);
		if (el.matches('[data-scramble]')) scramble(el);
	}), { threshold: 0.12 });
	$$('.rv, [data-scramble], .sat, .origin').forEach((el) => io.observe(el));

	/* ── paper abstracts ── */
	$$('[data-abs]').forEach((b) => b.addEventListener('click', () => {
		const box = document.getElementById(b.dataset.abs), open = box.classList.toggle('open');
		b.setAttribute('aria-expanded', String(open)); b.textContent = open ? 'abstract −' : 'abstract +';
	}));

	/* ── copy email ── */
	$('#mail').addEventListener('click', async () => {
		try { await navigator.clipboard.writeText(data.email); $('#mailHint').textContent = 'copied ✓'; toast('email copied. talk soon.'); }
		catch (e) { location.href = 'mailto:' + data.email; }
		setTimeout(() => { $('#mailHint').textContent = 'click to copy'; }, 2200);
	});
	$('#printBtn').addEventListener('click', () => print());

	/* ── off the clock: the barbell ── */
	const barSvg = $('#barSvg'), liftMsg = $('#liftMsg');
	$('#lift').addEventListener('click', () => {
		let n = +barSvg.dataset.n;
		if (barSvg.classList.contains('up')) { barSvg.classList.remove('up'); barSvg.dataset.n = 0; liftMsg.textContent = 'click to add plates'; return; }
		n = Math.min(3, n + 1); barSvg.dataset.n = n;
		if (n < 3) { liftMsg.textContent = n + ' plate' + (n > 1 ? 's' : '') + ' a side. more.'; return; }
		liftMsg.textContent = 'locked out. pr.';
		setTimeout(() => barSvg.classList.add('up'), 250);
		if (!egg('lift')) toast('another pr. the bar is getting nervous.');
	});
	/* the knight */
	const knight = $('#knight'); let kx = 0, ky = 3, hops = 0;
	const placeKnight = () => { knight.style.left = (kx * 25 + 12.5) + '%'; knight.style.top = (ky * 25 + 12.5) + '%'; knight.style.transform = 'translate(-50%,-50%)'; };
	placeKnight();
	$('#chess').addEventListener('click', () => {
		const moves = [[1,2],[2,1],[-1,2],[-2,1],[1,-2],[2,-1],[-1,-2],[-2,-1]].map(([a, b]) => [kx + a, ky + b]).filter(([a, b]) => a >= 0 && a < 4 && b >= 0 && b < 4);
		[kx, ky] = moves[(Math.random() * moves.length) | 0]; placeKnight(); hops++;
		$('#chessMsg').textContent = hops === 1 ? '1 move. the knight approves.' : hops + ' moves' + (hops >= 8 ? '. this is basically a tour.' : '.');
	});
	/* the coffee */
	let cups = +(store.get('cvCups') || 0);
	const paintCups = () => { $('#mug .fill').style.setProperty('--f', Math.min(1, (cups % 6) / 5)); $('#coffeeMsg').textContent = 'cups poured: ' + cups; };
	paintCups();
	$('#coffee').addEventListener('click', () => { cups++; store.set('cvCups', cups); paintCups(); if (cups % 6 === 5) toast('five cups. same, honestly.'); });

	/* ── the 4×4 sudoku ── */
	const GIVEN = [1,0,0,4, 0,4,0,0, 0,0,4,0, 4,0,0,1];
	const sdk = $('#sdk'), modal = $('#sudoku'), sdkMsg = $('#sdkMsg');
	let cells = GIVEN.slice();
	function drawSdk() {
		sdk.innerHTML = cells.map((v, i) => '<button type="button" style="--i:' + i + '" class="' + (GIVEN[i] ? 'given' : '') + '" data-i="' + i + '">' + (v || '') + '</button>').join('');
	}
	function solved() {
		const groups = [];
		for (let r = 0; r < 4; r++) groups.push([0,1,2,3].map((c) => cells[r * 4 + c]));
		for (let c = 0; c < 4; c++) groups.push([0,1,2,3].map((r) => cells[r * 4 + c]));
		for (const [r0, c0] of [[0,0],[0,2],[2,0],[2,2]]) groups.push([0,1,2,3].map((k) => cells[(r0 + (k >> 1)) * 4 + c0 + (k & 1)]));
		return groups.every((g) => new Set(g).size === 4 && !g.includes(0));
	}
	sdk.addEventListener('click', (e) => {
		const b = e.target.closest('button'); if (!b || b.classList.contains('given') || sdk.classList.contains('won')) return;
		const i = +b.dataset.i; cells[i] = (cells[i] + 1) % 5; b.textContent = cells[i] || '';
		if (solved()) { sdk.classList.add('won'); sdkMsg.textContent = 'solved. that was faster than reading my cv.'; egg('sudoku'); }
	});
	function openSudoku() { if (sdk.classList.contains('won')) { cells = GIVEN.slice(); sdk.classList.remove('won'); sdkMsg.innerHTML = '&nbsp;'; } drawSdk(); modal.hidden = false; $('button:not(.given)', sdk).focus(); }
	$('#sudokuTile').addEventListener('click', openSudoku);
	$('#sdkX').addEventListener('click', () => { modal.hidden = true; });
	modal.addEventListener('click', (e) => { if (e.target === modal) modal.hidden = true; });

	/* ── the fruit fly: buzzes in now and then; catch it ── */
	const FLY = '<svg viewBox="0 0 30 30"><ellipse class="w" cx="9" cy="10" rx="7" ry="4" fill="currentColor" transform="rotate(-25 9 10)"/><ellipse class="w" cx="21" cy="10" rx="7" ry="4" fill="currentColor" transform="rotate(25 21 10)"/><ellipse cx="15" cy="17" rx="4.2" ry="7" fill="currentColor"/><circle cx="15" cy="9" r="3.4" fill="currentColor"/><circle cx="13.4" cy="8.4" r="1.2" fill="#d3101c"/><circle cx="16.6" cy="8.4" r="1.2" fill="#d3101c"/></svg>';
	let flyEl = null, flyRaf = 0, flyTimer = 0, mouse = { x: -999, y: -999 };
	addEventListener('pointermove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
	function spawnFly() {
		if (flyEl || document.hidden) return schedFly();
		flyEl = document.createElement('button'); flyEl.className = 'fly'; flyEl.type = 'button'; flyEl.setAttribute('aria-label', 'a fruit fly. catch it.'); flyEl.innerHTML = FLY;
		document.body.appendChild(flyEl);
		const fromLeft = Math.random() < 0.5;
		let x = fromLeft ? -30 : innerWidth + 30, y = innerHeight * (0.2 + Math.random() * 0.6), vx = 0, vy = 0, tx = innerWidth / 2, ty = y, t0 = performance.now(), nextT = 0, leaving = false;
		flyEl.addEventListener('click', (e) => {
			e.stopPropagation(); cancelAnimationFrame(flyRaf); flyEl.classList.add('caught');
			const was = flyEl; flyEl = null; setTimeout(() => was.remove(), 650);
			if (!egg('fly')) toast('caught another one. that’s ' + (+(store.get('cvFlies') || 1) + 1) + '.');
			store.set('cvFlies', +(store.get('cvFlies') || 0) + 1);
			schedFly();
		});
		(function step(t) {
			if (!flyEl) return;
			if (t > nextT) { tx = 40 + Math.random() * (innerWidth - 80); ty = 70 + Math.random() * (innerHeight - 140); nextT = t + 500 + Math.random() * 900; }
			if (t - t0 > 14000 && !leaving) { leaving = true; tx = fromLeft ? innerWidth + 80 : -80; nextT = Infinity; }
			// flee the cursor a little: that's the game
			const dx = x - mouse.x, dy = y - mouse.y, d = Math.hypot(dx, dy);
			if (d < 110) { vx += dx / d * 1.6; vy += dy / d * 1.6; }
			vx += (tx - x) * 0.0028 + (Math.random() - 0.5) * 1.4; vy += (ty - y) * 0.0028 + (Math.random() - 0.5) * 1.4;
			vx *= 0.9; vy *= 0.9; x += vx; y += vy;
			flyEl.style.transform = 'translate(' + x + 'px,' + y + 'px) rotate(' + (Math.atan2(vy, vx) * 57.3 + 90) + 'deg)';
			if (leaving && (x < -60 || x > innerWidth + 60)) { flyEl.remove(); flyEl = null; return schedFly(); }
			flyRaf = requestAnimationFrame(step);
		})(t0);
	}
	$('#flyTile').addEventListener('click', () => { if (flyEl) toast('it’s already out. look around.'); else { spawnFly(); toast('released. it flees the cursor.'); } });
	function schedFly(ms) { clearTimeout(flyTimer); if (reduce && ms === undefined) return; flyTimer = setTimeout(spawnFly, ms !== undefined ? ms : 40000 + Math.random() * 35000); }
	schedFly(18000);

	/* ── konami: everything black turns red ── */
	const KONAMI = ['arrowup','arrowup','arrowdown','arrowdown','arrowleft','arrowright','arrowleft','arrowright','b','a']; let kp = 0;
	function redMode() { const on = document.documentElement.toggleAttribute('data-red'); toast(on ? '↑↑↓↓←→←→ b a — <b>seeing red.</b>' : 'back to black.'); egg('konami'); }

	/* ── the terminal ── */
	const term = $('#term'), out = $('#termOut'), inp = $('#termIn'); const hist = []; let hi = 0;
	const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
	function say(html, cls) { const d = document.createElement('div'); if (cls) d.className = cls; d.innerHTML = html; out.appendChild(d); out.scrollTop = out.scrollHeight; }
	function openTerm() {
		term.classList.add('open'); term.setAttribute('aria-hidden', 'false');
		if (!out.childElementCount) say('<span class="b">utku-os 17.' + Math.floor((age(Date.now()) % 1) * 1000) + '</span> — type <span class="r">help</span>. esc to close.\n', 'c');
		setTimeout(() => inp.focus(), 50); egg('terminal');
	}
	function closeTerm() { term.classList.remove('open'); term.setAttribute('aria-hidden', 'true'); inp.blur(); }
	$('#termBtn').addEventListener('click', () => term.classList.contains('open') ? closeTerm() : openTerm());
	$('#termX').addEventListener('click', closeTerm);
	const bar = (v, max) => '█'.repeat(Math.round(v / max * 20)).padEnd(20, '░');
	const CMDS = {
		help: () => 'whoami · about · age · sat · projects · open &lt;name&gt; · papers · honours · contact · coffee · lift · fly · sudoku · eggs · hire · clear · exit',
		whoami: () => 'mehmet utku öztürk — machine learning developer &amp; ai researcher, ankara.\nage ' + age(Date.now()).toFixed(9) + '. unpredictable, unsatisfied, unconventional.',
		about: () => 'started programming at 8. c++ and c# by 11. machine learning at 13. first llm fine-tune at 14 (extremely unsuccessfully).\nnow: artificial consciousness and “thinking” systems.',
		age: () => age(Date.now()).toFixed(12) + ' years. still compiling.',
		sat: () => 'math              ' + bar(data.sat.math, 800) + ' ' + data.sat.math + '\nreading &amp; writing ' + bar(data.sat.rw, 800) + ' ' + data.sat.rw + '\n<span class="b">total             ' + (data.sat.math + data.sat.rw) + ' / 1600</span>',
		projects: () => data.projects.map((p) => (p.status === 'active' ? '<span class="g">●</span>' : p.status === 'paused' ? '○' : '<span class="c">·</span>') + ' ' + esc(p.name).padEnd(26) + '<span class="c">' + esc(p.category) + ' · ' + esc(p.role) + '</span>').join('\n') + '\n<span class="c">try: open flydoom</span>',
		ls: () => 'about.txt  sat.txt  projects/  papers/  honours.txt  contact.txt  <span class="c">.secrets</span>',
		cat: (a) => a === '.secrets' ? 'there are 8 easter eggs on this page. one of them is in your browser console.' : a === 'sat.txt' ? CMDS.sat() : a === 'about.txt' ? CMDS.about() : a === 'honours.txt' ? CMDS.honours() : a === 'contact.txt' ? CMDS.contact() : 'cat: ' + esc(a || '') + ': no such file. try ls.',
		open: (a) => {
			const p = data.projects.find((p) => p.name.toLowerCase().startsWith((a || '').toLowerCase()));
			if (!a || !p) return 'open what? try: open flydoom';
			if (!p.link) return esc(p.name) + ' has no public link yet. it’s ' + p.status + '.';
			window.open(p.link, '_blank', 'noopener'); return 'opening ' + esc(p.name) + ' ↗';
		},
		papers: () => data.papers.map((p) => p.year + '  ' + esc(p.name) + '\n      <span class="c">' + esc(p.venue) + '</span>' + (p.link ? '  <a href="' + p.link + '" target="_blank" rel="noopener">link ↗</a>' : '')).join('\n'),
		honours: () => data.honours.map(esc).join('\n'),
		contact: () => '<a href="mailto:' + data.email + '">' + data.email + '</a> · github.com/mutkuoz · linkedin.com/in/mutkuoz',
		coffee: () => { cups++; store.set('cvCups', cups); paintCups(); return '  ( (\n   ) )\n ........\n |      |]\n \\      /\n  `----’   cup #' + cups; },
		lift: () => { $('#lift').click(); $('#lift').click(); $('#lift').click(); return 'bar loaded. 3 plates a side. lockout.'; },
		fly: () => { if (flyEl) return 'it’s already here. look around.'; spawnFly(); return 'released one drosophila melanogaster. catch it.'; },
		sudoku: () => { closeTerm(); openSudoku(); return 'opening sudoku…'; },
		eggs: () => Object.keys(EGGS).map((k) => (found.has(k) ? '<span class="g">✓</span> ' + EGGS[k] : '<span class="c">· ???</span>')).join('\n') + '\n' + found.size + '/8',
		hire: () => { egg('hire'); return '<span class="g">permission granted.</span> sending this to m@utku.space…\n(no, really: <a href="mailto:' + data.email + '?subject=hello%20from%20your%20cv">click here</a>)'; },
		sudo: (a) => /hire/.test(a || '') ? CMDS.hire() : 'sudo: nice try.',
		konami: () => 'use the arrow keys. b. a.',
		date: () => new Date().toString(),
		echo: (a) => esc(a || ''),
		rm: () => 'rm: refusing. i’m unconventional, not reckless.',
		clear: () => { out.innerHTML = ''; return null; },
		exit: () => { closeTerm(); return null; }
	};
	inp.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') { closeTerm(); return; }
		if (e.key === 'ArrowUp') { if (hi > 0) inp.value = hist[--hi]; e.preventDefault(); return; }
		if (e.key === 'ArrowDown') { inp.value = hi < hist.length - 1 ? hist[++hi] : (hi = hist.length, ''); e.preventDefault(); return; }
		if (e.key !== 'Enter') return;
		const raw = inp.value.trim(); inp.value = ''; if (!raw) return;
		hist.push(raw); hi = hist.length;
		say('<span class="r">$</span> ' + esc(raw));
		const [cmd, ...rest] = raw.split(/\s+/), fn = CMDS[cmd.toLowerCase()];
		const res = fn ? fn(rest.join(' ')) : esc(cmd) + ': command not found. try help.';
		if (res !== null) say(res + '\n');
	});

	/* ── keys: / opens the terminal, konami, esc closes things ── */
	addEventListener('keydown', (e) => {
		const t = e.target, typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
		const k = e.key.toLowerCase();
		if (!typing) {
			if (k === KONAMI[kp]) { if (++kp === KONAMI.length) { kp = 0; redMode(); } } else kp = k === KONAMI[0] ? 1 : 0;
			if ((e.key === '/' || e.key === '`') && !e.metaKey && !e.ctrlKey) { e.preventDefault(); openTerm(); }
		}
		if (e.key === 'Escape') { modal.hidden = true; if (!typing) closeTerm(); }
	});

	/* ── reading to the end ── */
	new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { o.disconnect(); setTimeout(() => egg('end'), 600); } }), { threshold: 0.9 }).observe($('#foot'));

	/* ── leaving the tab ── */
	const title0 = document.title;
	document.addEventListener('visibilitychange', () => { document.title = document.hidden ? 'unfinished business — come back' : title0; });

	/* ── a cursor ring that grows over anything clickable ── */
	if (!reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
		const ring = $('.ring'); let rx = 0, ry = 0, has = false;
		addEventListener('pointermove', (e) => { if (!has) { rx = e.clientX; ry = e.clientY; has = true; ring.classList.add('on'); } ring.classList.toggle('big', !!e.target.closest('a, button, [role=button], .tile')); }, { passive: true });
		document.addEventListener('pointerleave', () => ring.classList.remove('on'));
		(function loop() { rx += (mouse.x - rx) * 0.22; ry += (mouse.y - ry) * 0.22; ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px)'; requestAnimationFrame(loop); })();
	}

	/* ── for the ones who open devtools ── */
	console.log('%cunpredictable. unsatisfied. unconventional.', 'font: 800 22px Georgia, serif; color: #d3101c');
	console.log('%cyou opened devtools on a cv. good instinct.\ntry: utku.hire()', 'font: 13px ui-monospace, monospace; color: #888');
	window.utku = { hire() { egg('hire'); return 'offer noted. now email m@utku.space and make it official.'; }, age() { return age(Date.now()); } };
})();
</script>
</body>
</html>
