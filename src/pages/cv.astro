---
// cv.utku.space — the application edition of utku.space. same paper (the fresco, black on
// white, newsreader and playfair, hairlines), set as a cv: a cover, a margin column of
// section labels, a timeline you can scrub, a numbered catalogue of work, and a sign-off.
// everything (css, js, data) is inline and every asset loads from utku.space by absolute
// url, so the built html runs unchanged at utku.space/cv/ and, copied, at cv.utku.space.
import { papers } from '../data/research';
import { projects, categories, categoryIcon, statusLabel } from '../data/projects';
import { associations } from '../data/associations';
import { SITE, articleUrl, formatDate, getArticles } from '../lib/site';

const A = SITE;
const CANONICAL = 'https://cv.utku.space/';
const title = 'mehmet utku öztürk — unpredictable, unsatisfied, unconventional';
const description =
	'cv of mehmet utku öztürk, machine learning developer and ai researcher in ankara, türkiye: projects, research, honours, and numbers.';
const articles = await getArticles();

// project bodies link relative to utku.space; on cv.utku.space they need the full origin
const absolute = (html: string) => html.replace(/href="\//g, `href="${SITE}/`);
const firstLink = (html: string) => (html.match(/href="([^"]+)"/) ?? [])[1];
const catCount = (key: string) => projects.filter((p) => p.category === key).length;

const sat = { math: 800, rw: 710 };

const honours = [
	{ year: '2026', title: 'hukukbert, first author', note: 'journal of computational law and legal technology. the most comprehensive legal language model for turkish.', href: 'https://doi.org/10.47852/bonviewJCLLT620210346' },
	{ year: '2025 —', title: 'tübitak-backed r&d', note: 'labgpt: test result analysis for doctors, with a corpus of years of medical research.' },
	{ year: '2025', title: 'octapar, author', note: 'zenodo. balanced user grouping with attentional embeddings and the hungarian method.', href: 'https://zenodo.org/records/17360220' },
	{ year: '2024 —', title: 'bilsem, senior student & mentor', note: 'government-led program for gifted children (top 2% iq). voluntarily teaching primary schoolers robotics, ai and software.' },
	{ year: '2023–24', title: 'clade ai, co-founder', note: 'personal ai assistant. held a $21m round.' },
	{ year: '2023', title: 'etwinning national quality label', note: 'european union, etwinning. project: “particle physics and cern”.' },
	{ year: '2018', title: 'etwinning pupil quality label', note: 'european union, etwinning.' },
	{ year: 'member', title: 'mensa international', note: 'the largest and oldest high-iq society.' },
	{ year: 'member', title: 'iaail', note: 'international association for artificial intelligence and law.' }
];

// the scrubbable timeline: one entry per year, empty years get a line of their own
const FIRST = 2008, LAST = 2026;
const record: Record<number, string[]> = {
	2026: ['co-founded turkhukuk.ai, legaltech for turkish lawyers', 'hukukbert published, first author', 'flydoom: a fruit fly connectome playing doom', '007captcha, topazius, turkic-relevance-laya'],
	2025: ['labgpt, tübitak-backed medical r&d', 'octapar, the platform and the paper'],
	2024: ['started mentoring at bilsem', '“streaming intelligence” paper, with plawlabs'],
	2023: ['etwinning national quality label: “particle physics and cern”', 'co-founded clade ai', 'trstemmer, on pypi'],
	2022: ['started on machine learning, at 13', 'sorubot, and a first llm fine-tune'],
	2020: ['c++ and c#, by 11', 'a.d.a, a deterministic personal assistant', 'shoelace, a peer-based encryption algorithm'],
	2019: ['founded ananas studios, an indie game studio'],
	2018: ['etwinning pupil quality label'],
	2017: ['first small apps and scripts, at 8'],
	2008: ['born, 29 november']
};
const years = Array.from({ length: LAST - FIRST + 1 }, (_, i) => FIRST + i);

// numbers, set as a bubble-in answer sheet. age and years-coding are recomputed live on the page
const bday = (y: number) => Date.UTC(y, 10, 29) - (y <= 2015 ? 2 : 3) * 3600e3; // nov 29, 00:00 istanbul
const ageAt = (now: number) => {
	let y = new Date(now).getUTCFullYear(), last = bday(y);
	if (now < last) last = bday(--y);
	return (y - 2008) + (now - last) / (bday(y + 1) - last);
};
const CODING_SINCE = 2016;
type Field = { id: string; label: string; note?: string; value: string; kind: 'dec' | 'int' | 'ap'; subs?: string[] };
const fields: Field[] = [
	{ id: 'age', label: 'age', note: 'live', value: ageAt(Date.now()).toFixed(8), kind: 'dec' },
	{ id: 'dev', label: `developer since ${CODING_SINCE}`, note: 'years', value: String(new Date().getFullYear() - CODING_SINCE), kind: 'int' },
	{ id: 'gpa', label: 'gpa', note: 'unweighted', value: '4.00', kind: 'dec' },
	{ id: 'math', label: 'sat math', value: String(sat.math), kind: 'int' },
	{ id: 'rw', label: 'sat r&w', value: String(sat.rw), kind: 'int' },
	{ id: 'ap', label: 'ap exams', value: '5555', kind: 'ap', subs: ['calc ab', 'calc bc', 'csp', 'csa'] },
	{ id: 'papers', label: 'papers', value: '4', kind: 'int' }
];
const choices = { dec: ['.', ...'0123456789'], int: [...'0123456789'], ap: [...'12345'] };

// what the scripts know
const cvData = {
	email: 'm@utku.space',
	sat,
	gpa: '4.00 unweighted',
	ap: { 'calculus ab': 5, 'calculus bc': 5, 'computer science principles': 5, 'computer science a': 5 },
	papers: 4,
	codingSince: CODING_SINCE,
	first: FIRST,
	last: LAST,
	record,
	projects: projects.map((p) => ({ name: p.name, category: p.category, status: statusLabel[p.status], role: p.role, link: firstLink(absolute(p.body)) })),
	papers: papers.map((p) => ({ name: p.name, year: p.year, venue: p.journal ?? p.venue, link: p.links[0]?.url })),
	honours: honours.map((h) => `${h.year} · ${h.title}`)
};
const json = JSON.stringify(cvData).replace(/</g, '\\u003c');

const head = `
@font-face { font-family: 'Newsreader'; font-style: normal; font-weight: 400 600; font-display: swap; src: url('${A}/fonts/newsreader-normal-latin.woff2') format('woff2'); }
@font-face { font-family: 'Newsreader'; font-style: italic; font-weight: 400 500; font-display: swap; src: url('${A}/fonts/newsreader-italic-latin.woff2') format('woff2'); }
@font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 500 800; font-display: swap; src: url('${A}/fonts/playfair-display-normal-latin.woff2') format('woff2'); }
@font-face { font-family: 'Playfair Display'; font-style: italic; font-weight: 500 600; font-display: swap; src: url('${A}/fonts/playfair-display-italic-latin.woff2') format('woff2'); }
.page-bg { background-image: url('${A}/utku-bg.png'); background-image: image-set(url('${A}/utku-bg.webp') type('image/webp'), url('${A}/utku-bg.png') type('image/png')); }`;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<!-- an application file, not a search result: kept out of indexes on purpose -->
	<meta name="robots" content="noindex, follow" />
	<link rel="canonical" href={CANONICAL} />
	<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
	<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
	<link rel="icon" type="image/svg+xml" href={`${A}/favicon.svg`} />
	<link rel="preload" as="image" href={`${A}/utku-bg.webp`} type="image/webp" fetchpriority="high" />
	<link rel="preload" as="font" type="font/woff2" crossorigin href={`${A}/fonts/playfair-display-normal-latin.woff2`} />
	<link rel="preload" as="font" type="font/woff2" crossorigin href={`${A}/fonts/newsreader-normal-latin.woff2`} />
	<meta property="og:type" content="profile" />
	<meta property="og:url" content={CANONICAL} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={`${A}/portrait.png`} />
	<style is:inline set:html={head}></style>
	<style is:inline>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
	--serif:   'Newsreader', Georgia, 'Times New Roman', serif;
	--display: 'Playfair Display', Georgia, 'Times New Roman', serif;
	--mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
	--ease: cubic-bezier(0.4, 0, 0.2, 1);
	--out: cubic-bezier(0.2, 0.7, 0.1, 1);
}
/* ── the same black / white as utku.space ── */
[data-theme="light"] {
	--bg:#ffffff; --fg:#000000;
	--fg2:rgba(0,0,0,0.74); --muted:rgba(0,0,0,0.52); --muted2:rgba(0,0,0,0.36);
	--hair:rgba(0,0,0,0.16);
	--bg-art-opacity: 1; --bg-art-filter: none;
}
[data-theme="dark"] {
	--bg:#000000; --fg:#ffffff;
	--fg2:rgba(255,255,255,0.78); --muted:rgba(255,255,255,0.54); --muted2:rgba(255,255,255,0.38);
	--hair:rgba(255,255,255,0.20);
	--bg-art-opacity: 1; --bg-art-filter: grayscale(1) brightness(0.13) contrast(1.2);
}
/* konami: red instead of black, everywhere */
[data-konami][data-theme="light"] { --fg:#d3101c; --fg2:rgba(211,16,28,0.82); --muted:rgba(211,16,28,0.62); --muted2:rgba(211,16,28,0.42); --hair:rgba(211,16,28,0.24); --bg-art-filter: url(#redInk); }
[data-konami][data-theme="dark"] { --bg:#d3101c; --fg2:rgba(255,255,255,0.86); --muted:rgba(255,255,255,0.66); --muted2:rgba(255,255,255,0.46); --hair:rgba(255,255,255,0.3); --bg-art-opacity: 0.9; --bg-art-filter: grayscale(1) brightness(0.13) contrast(1.2) url(#redInk); }
[data-konami] img { filter: url(#redInk); }
[data-konami][data-theme="dark"] .clock-fig img { filter: brightness(0.86) contrast(1.05) url(#redInk); }

html { scroll-behavior: smooth; background: var(--bg); transition: background-color 0.35s ease; }
body {
	font-family: var(--serif); font-optical-sizing: auto; text-transform: lowercase;
	color: var(--fg); background: transparent; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale;
	transition: color 0.35s ease; min-height: 100vh; line-height: 1.5;
	overflow-x: clip; /* the portrait's glow reaches past the edge on mid-size screens */
}
::selection { background: var(--fg); color: var(--bg); }
button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; text-transform: inherit; text-align: inherit; }
button:focus-visible, a:focus-visible, [tabindex]:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }

/* ── fixed background artwork ── */
.page-bg {
	position: fixed; inset: 0; z-index: 0; pointer-events: none;
	background-position: center center; background-repeat: no-repeat; background-size: cover; background-attachment: fixed;
	opacity: var(--bg-art-opacity); filter: var(--bg-art-filter); transition: opacity 0.35s ease, filter 0.35s ease;
}
@supports (-webkit-touch-callout: none) { .page-bg { background-attachment: scroll; } }
#scrollProgress { position: fixed; top: 0; left: 0; height: 2px; width: 100%; transform-origin: 0 50%; transform: scaleX(0); background: var(--fg); z-index: 200; opacity: 0.6; }

/* ── navbar ── */
#navbar {
	position: fixed; top: 0; left: 0; right: 0; z-index: 100;
	display: flex; align-items: center; gap: 1rem; height: 3.4rem; padding: 0 1.3rem;
	background: color-mix(in srgb, var(--bg) 86%, transparent);
	backdrop-filter: blur(7px); -webkit-backdrop-filter: blur(7px);
	border-bottom: 1px solid var(--hair); transition: background 0.35s ease, border-color 0.35s ease;
}
@media (min-width: 720px) { #navbar { padding: 0 2rem; } }
.nav-brand { font-family: var(--display); font-style: italic; font-weight: 600; font-size: 1.02rem; color: var(--fg); text-decoration: none; white-space: nowrap; }
.nav-sub { font-style: italic; font-size: 0.86rem; color: var(--muted); margin-left: -0.5rem; white-space: nowrap; }
.nav-links { display: none; gap: 1.6rem; margin-left: auto; margin-right: 1.3rem; }
@media (min-width: 1040px) { .nav-links { display: flex; } }
@media (max-width: 1039px) { .mode-toggle { margin-left: auto; } }
.nav-link { font-size: 0.86rem; letter-spacing: 0.02em; color: var(--muted); text-decoration: none; position: relative; padding-bottom: 2px; transition: color 0.18s ease; }
.nav-link::after { content: ''; position: absolute; left: 0; right: 100%; bottom: 0; height: 1px; background: var(--fg); transition: right 0.25s var(--ease); }
.nav-link:hover, .nav-link.on { color: var(--fg); }
.nav-link:hover::after, .nav-link.on::after { right: 0; }
.mode-toggle {
	display: flex; align-items: center; justify-content: center; flex: none;
	width: 2rem; height: 2rem; border-radius: 50%; border: 1px solid var(--hair); color: var(--fg);
	transition: border-color 0.2s ease, transform 0.4s cubic-bezier(0.34,1.4,0.64,1);
}
.mode-toggle:hover { border-color: var(--fg); transform: rotate(-22deg); }
.mode-toggle svg { width: 0.95rem; height: 0.95rem; }
[data-theme="light"] .icon-moon { display: none; }
[data-theme="dark"] .icon-sun { display: none; }

/* ── page column ── */
.paper { position: relative; z-index: 1; max-width: 80rem; margin: 0 auto; padding: 5.4rem 1.3rem 4rem; }
@media (min-width: 720px) { .paper { padding: 6.2rem 2.4rem 5rem; } }

/* ── the cover ── */
.front { display: flex; flex-direction: column; min-height: calc(86svh - 5.4rem); }
@media (min-width: 720px) { .front { min-height: calc(100svh - 8.4rem); } }
.cover { min-height: 1.5em; font-style: italic; font-size: 0.95rem; color: var(--muted); }
.caret { display: inline-block; width: 1px; height: 1em; margin-left: 2px; vertical-align: -0.12em; background: var(--fg); animation: blink 1s steps(1) infinite; }
.cover.done .caret { animation: blink 1s steps(1) 4 forwards; }
@keyframes blink { 0% { opacity: 1; } 50%, 100% { opacity: 0; } }
.front-grid { flex: 1; display: grid; grid-template-columns: minmax(0, 1fr); align-items: end; gap: 1.5rem; margin-top: 2rem; }
@media (min-width: 840px) { .front-grid { grid-template-columns: minmax(0, 1fr) min(26rem, 34%); } }
.headline { font-family: var(--display); font-weight: 700; font-size: clamp(2.8rem, 7.6vw, 6.9rem); line-height: 0.98; letter-spacing: -0.035em; padding-bottom: 0.5rem; }
.hl { display: block; overflow: hidden; padding: 0 0.08em 0.12em 0; margin-bottom: -0.12em; }
.hl-in { display: inline-block; transform: translateY(112%); transition: transform 1s var(--out); }
.front.in .hl-in { transform: none; }
.front.in .hl:nth-child(2) .hl-in { transition-delay: 0.12s; }
.front.in .hl:nth-child(3) .hl-in { transition-delay: 0.24s; }
/* the “un” is the only italic: it comes off */
.un { font-style: italic; font-weight: 600; letter-spacing: -0.02em; display: inline-block; transition: opacity 0.2s ease; }
.un:hover { opacity: 0.55; }
.hl.off .un { animation: unfall 1.4s var(--ease) forwards; }
.hl.off .rest { text-decoration: line-through; text-decoration-thickness: 0.06em; }
@keyframes unfall { 35% { transform: translate(-0.05em, 0.5em) rotate(-18deg); opacity: 0.7; } 60% { transform: translate(-0.1em, 1.3em) rotate(-40deg); opacity: 0; } 61% { transform: translateY(-1em); opacity: 0; } 100% { transform: none; opacity: 1; } }
.front-fig { display: none; }
@media (min-width: 840px) { .front-fig { display: block; margin-right: -1rem; opacity: 0; transform: translateY(14px); transition: opacity 1.1s ease 0.35s, transform 1.1s var(--out) 0.35s; } .front.in .front-fig { opacity: 1; transform: none; } }
.fig-slot { position: relative; isolation: isolate; }
.fig-slot img { display: block; width: 100%; height: auto; }
.fig-slot::before {
	content: ''; position: absolute; inset: -10% -12% 0; z-index: -1; pointer-events: none;
	background: radial-gradient(ellipse 50% 60% at 50% 66%, rgba(246,243,236,0.95) 0%, rgba(246,243,236,0.9) 22%, rgba(246,243,236,0.74) 38%, rgba(246,243,236,0.52) 52%, rgba(246,243,236,0.32) 65%, rgba(246,243,236,0.16) 77%, rgba(246,243,236,0.06) 88%, transparent 100%);
	-webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent 100%); mask-image: linear-gradient(to bottom, #000 80%, transparent 100%);
	opacity: 0; transition: opacity 0.35s ease;
}
[data-theme="dark"] .fig-slot::before { opacity: 1; }
/* the byline under the cover */
.byline { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1.4rem; padding-top: 0.75rem; border-top: 1.5px solid var(--fg); font-style: italic; font-size: 0.95rem; color: var(--muted); }
.byline b { font-family: var(--display); font-style: normal; font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; color: var(--fg); }

/* ── sections: a margin label, then the body ── */
.sec { display: grid; grid-template-columns: 11.5rem minmax(0, 1fr); gap: 0.8rem 3rem; margin-top: 4.4rem; padding-top: 1rem; border-top: 1px solid var(--hair); scroll-margin-top: 4.4rem; }
.sec-label { position: sticky; top: 4.8rem; align-self: start; }
.sec-label h2 { font-family: var(--display); font-style: italic; font-weight: 600; font-size: 1.5rem; line-height: 1.15; letter-spacing: -0.01em; }
.sec-label p { margin-top: 0.3rem; font-style: italic; font-size: 0.85rem; color: var(--muted); }
@media (max-width: 899px) {
	.sec { grid-template-columns: minmax(0, 1fr); margin-top: 3.4rem; }
	.sec-label { position: static; display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.6rem; }
	.sec-label p { margin-top: 0; text-align: right; }
}

/* ── reveal on scroll ── */
.reveal { opacity: 0; transform: translateY(14px); transition: opacity 0.6s var(--ease), transform 0.6s var(--ease); }
.reveal.visible { opacity: 1; transform: none; }

/* ── about ── */
.standfirst { font-size: clamp(1.15rem, 1.7vw, 1.45rem); line-height: 1.8; text-align: justify; hyphens: auto; max-width: 52rem; }
.standfirst::first-letter { float: left; font-family: var(--display); font-weight: 700; font-size: 4.4em; line-height: 0.78; margin: -0.1em 0.08em 0 -0.02em; }

/* ── numbers: a bubble-in answer sheet, read by a scanner ── */
#numbers { margin-top: 4.4rem; scroll-margin-top: 4.4rem; }
.sheet { --cw: 1.45rem; --bs: 1.08rem; position: relative; overflow: hidden; padding: 1.1rem 1.3rem 1.1rem 2.7rem; background: var(--bg); border: 1.5px solid var(--fg); transition: background-color 0.35s ease; }
/* the timing marks down the edge of every scantron */
.sheet::before { content: ''; position: absolute; left: 0.9rem; top: 1.1rem; bottom: 1.1rem; width: 0.75rem; background: repeating-linear-gradient(to bottom, var(--fg) 0 0.3rem, transparent 0.3rem 1.2rem); }
.sheet-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1.6rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--fg); }
.sheet-head h2 { font-family: var(--display); font-weight: 700; font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1; letter-spacing: -0.02em; }
.sheet-kind { font-size: 0.74rem; letter-spacing: 0.04em; color: var(--muted); }
.sheet-name { display: flex; align-items: baseline; gap: 0.6rem; margin-left: auto; font-size: 0.74rem; letter-spacing: 0.03em; color: var(--muted); }
.sheet-name i { display: inline-block; min-width: 13rem; padding: 0 0.4rem 0.1rem; border-bottom: 1px solid var(--fg); font-family: var(--display); font-weight: 600; font-size: 1.15rem; letter-spacing: 0; color: var(--fg); transform: rotate(-1.2deg); }
/* one row on wide screens, two below, pairs on phones */
.fields { display: grid; grid-template-columns: repeat(7, auto); gap: 0.6rem; margin-top: 1rem; }
.field { display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--fg); }
@media (max-width: 1259px) {
	.fields { grid-template-columns: repeat(12, minmax(0, 1fr)); }
	.field { grid-column: span 3; }
	[data-field="age"] { grid-column: span 6; }
	[data-field="ap"] { grid-column: span 4; }
	[data-field="papers"] { grid-column: span 2; }
}
@media (max-width: 899px) {
	.fields { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.field, [data-field="ap"], [data-field="papers"] { grid-column: span 1; }
	[data-field="age"] { grid-column: 1 / -1; }
}
.f-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.45rem; padding: 0.3rem 0.55rem; background: var(--fg); color: var(--bg); font-size: 0.72rem; letter-spacing: 0.03em; line-height: 1.4; }
.f-head b { font-family: var(--display); font-weight: 700; font-size: 0.9rem; }
.f-head em { margin-left: auto; padding-left: 0.6rem; font-size: 0.68rem; opacity: 0.7; }
.f-cols { display: flex; justify-content: center; gap: 0.22rem; padding: 0.6rem 0.55rem 0.7rem; }
.col { display: flex; flex-direction: column; align-items: center; gap: 0.2rem; width: var(--cw); }
.f-ap .col { width: 2.3rem; }
.box { display: grid; place-items: center; width: 100%; height: 2rem; margin-bottom: 0.3rem; border: 1px solid var(--fg); font-family: var(--display); font-style: italic; font-weight: 600; font-size: 1.35rem; line-height: 1; }
.box span { display: inline-block; transform: rotate(var(--r, 0deg)); transition: opacity 0.3s ease var(--d, 0s); }
.col:nth-child(odd) .box span { --r: -4deg; }
.col:nth-child(3n) .box span { --r: 3deg; }
.b { position: relative; display: grid; place-items: center; width: var(--bs); height: var(--bs); border: 1px solid var(--muted2); border-radius: 50%; font-size: 0.56rem; line-height: 1; color: var(--muted); font-variant-numeric: lining-nums; cursor: pointer; user-select: none; -webkit-user-select: none; }
/* the pencil: a slightly rough, slightly overfilled blot */
.b::after { content: ''; position: absolute; inset: -1px; border-radius: 50%; background: var(--fg); opacity: 0.93; filter: url(#pencil); transform: scale(0); transition: transform 0.22s var(--out) var(--d, 0s); }
.b.on::after { transform: scale(var(--s, 1.06)) rotate(var(--r, 0deg)); }
.b:nth-child(3n) { --s: 1.1; --r: 25deg; }
.b:nth-child(4n+1) { --s: 1.03; --r: -40deg; }
.col:nth-child(even) .b { --r: 70deg; }
.sheet.pre .b.on::after { transform: scale(0); }
.sheet.pre .box span { opacity: 0; }
.sheet.live .b::after, .sheet.live .box span { transition-delay: 0s; }
.sub { margin-top: 0.35rem; font-size: 0.64rem; line-height: 1.15; letter-spacing: 0.02em; text-align: center; color: var(--muted); }
.scanline { position: absolute; top: 0; bottom: 0; left: 0; width: 2px; background: var(--fg); opacity: 0; pointer-events: none; }
.scanline::before { content: ''; position: absolute; top: 0; bottom: 0; right: 2px; width: 5rem; background: linear-gradient(to right, transparent, color-mix(in srgb, var(--fg) 9%, transparent)); }
.sheet.scan .scanline { animation: sweep 1.8s linear forwards; }
@keyframes sweep { 0% { left: 0; opacity: 0; } 5% { opacity: 0.5; } 95% { opacity: 0.5; } 100% { left: 100%; opacity: 0; } }
.sheet-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.3rem 1rem; margin-top: 0.9rem; font-size: 0.68rem; letter-spacing: 0.04em; color: var(--muted); }
@media (max-width: 620px) {
	.sheet { --cw: 1.3rem; --bs: 0.98rem; padding: 0.9rem 0.8rem 0.9rem 1.9rem; }
	.sheet::before { left: 0.6rem; width: 0.55rem; }
	.sheet-name { margin-left: 0; }
	.sheet-name i { min-width: 0; }
	.f-cols { padding: 0.5rem 0.4rem 0.6rem; gap: 0.15rem; }
	.f-ap .col { width: 1.75rem; }
	.f-head { display: block; }
	.f-head b { margin-right: 0.4rem; }
	.f-head em { margin-left: 0; padding-left: 0.3rem; }
}

/* ── hairline rows: honours ── */
.rows { border-bottom: 1px solid var(--hair); }
.row { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) 1.4rem; gap: 0.2rem 1.5rem; align-items: baseline; padding: 0.95rem 0; border-top: 1px solid var(--hair); color: var(--fg); text-decoration: none; transition: padding-left 0.25s var(--ease); }
.row:first-child { border-top: 0; padding-top: 0.3rem; }
a.row:hover { padding-left: 0.4rem; }
.row-y { font-size: 0.74rem; letter-spacing: 0.03em; color: var(--muted); }
.row-t { font-family: var(--display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; line-height: 1.34; }
.row-n { display: block; font-family: var(--serif); font-weight: 400; font-size: 0.93rem; letter-spacing: 0; color: var(--fg2); margin-top: 0.15rem; }
.row-a { color: var(--muted); text-align: right; transition: transform 0.18s ease, color 0.18s ease; }
a.row:hover .row-a { color: var(--fg); transform: translate(0.15rem, -0.1rem); }
@media (max-width: 620px) { .row { grid-template-columns: minmax(0, 1fr) 1.2rem; } .row-y { grid-column: 1 / -1; } }

/* ── the timeline scrubber ── */
.tl-axis { position: relative; display: grid; height: 4rem; border-bottom: 1.5px solid var(--fg); cursor: ew-resize; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
.tl-tick { position: relative; height: 100%; }
.tl-tick::before { content: ''; position: absolute; left: 50%; bottom: 0; width: 1px; height: 0.6rem; background: var(--muted2); transition: height 0.3s var(--out), background 0.3s ease; }
.tl-tick.has::before { height: 1.4rem; background: var(--fg); }
.tl-tick.on::before { height: 2.5rem; width: 2px; margin-left: -0.5px; background: var(--fg); }
.tl-tick span { position: absolute; left: 50%; top: 0.1rem; transform: translateX(-50%); font-size: 0.7rem; letter-spacing: 0.02em; color: var(--muted); white-space: nowrap; opacity: 0; transition: opacity 0.2s ease, color 0.2s ease; }
.tl-tick.has span { opacity: 1; }
.tl-tick.on span { opacity: 1; color: var(--fg); font-weight: 600; }
.tl-ends { display: flex; justify-content: space-between; margin-top: 0.35rem; font-size: 0.72rem; font-style: italic; color: var(--muted); }
.tl-panel { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 0.5rem 2rem; align-items: start; margin-top: 1.4rem; min-height: 9.5rem; }
.tl-year { font-family: var(--display); font-style: italic; font-weight: 600; font-size: clamp(3rem, 6vw, 4.6rem); line-height: 0.95; letter-spacing: -0.03em; font-variant-numeric: lining-nums; }
.tl-age { font-style: italic; font-size: 0.85rem; color: var(--muted); margin-bottom: 0.45rem; }
.tl-list { list-style: none; display: grid; gap: 0.3rem; }
.tl-list li { font-size: 1.05rem; color: var(--fg2); padding-left: 1rem; position: relative; animation: rise 0.45s var(--out) both; animation-delay: calc(var(--k) * 55ms); }
.tl-list li::before { content: '—'; position: absolute; left: 0; color: var(--muted2); }
.tl-list li.quiet { font-style: italic; color: var(--muted); padding-left: 0; }
.tl-list li.quiet::before { content: none; }
.tl-year.flip { animation: rise 0.4s var(--out); }
@keyframes rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
@media (max-width: 620px) {
	.tl-tick span { font-size: 0.62rem; }
	.tl-tick.has span { opacity: 0; }
	.tl-tick.on span { opacity: 1; }
	.tl-panel { grid-template-columns: 1fr; }
}

/* ── work: a numbered catalogue ── */
.filters { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.4rem; margin-bottom: 0.9rem; }
.filter { display: inline-flex; align-items: center; gap: 0.4rem; padding-bottom: 2px; font-style: italic; font-size: 0.98rem; color: var(--muted); border-bottom: 1px solid transparent; transition: color 0.18s ease, border-color 0.18s ease; }
.filter svg { width: 1rem; height: 1rem; flex: none; }
.filter:hover { color: var(--fg); }
.filter[aria-pressed="true"] { color: var(--fg); border-bottom-color: var(--fg); }
.filter sup { font-style: normal; font-size: 0.65rem; color: var(--muted2); }
.filters .ghost-link { margin-left: auto; }
.cat { list-style: none; border-top: 1.5px solid var(--fg); border-bottom: 1px solid var(--hair); }
.cat-row { border-top: 1px solid var(--hair); }
.cat-row:first-child { border-top: 0; }
.cat-row[hidden] { display: none; }
.cat-row.pop { animation: rise 0.4s var(--out) both; animation-delay: calc(var(--k) * 35ms); }
.cat-head { width: 100%; display: grid; grid-template-columns: 2.8rem minmax(0, 1fr) auto 1.4rem; align-items: baseline; gap: 1rem; padding: 0.95rem 0; transition: padding-left 0.25s var(--ease); }
.cat-head:hover { padding-left: 0.4rem; }
.cat-n { font-family: var(--display); font-style: italic; font-size: 0.95rem; color: var(--muted); font-variant-numeric: lining-nums tabular-nums; }
.cat-name { display: flex; align-items: baseline; gap: 0.55rem; min-width: 0; font-family: var(--display); font-weight: 700; font-size: clamp(1.15rem, 1.7vw, 1.42rem); letter-spacing: -0.01em; line-height: 1.3; }
.cat-role { font-size: 0.78rem; letter-spacing: 0.02em; color: var(--muted); text-align: right; white-space: nowrap; }
.cat-plus { text-align: right; }
.cat-plus::after { content: '+'; font-family: var(--display); font-size: 1.3rem; line-height: 1; }
.cat-row.open .cat-plus::after { content: '\2212'; }
.cat-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.34s var(--ease); }
.cat-body > div { overflow: hidden; min-height: 0; padding-left: 3.8rem; }
.cat-row.open .cat-body { grid-template-rows: 1fr; }
.cat-body p { padding-bottom: 1.1rem; max-width: 48rem; font-size: 0.97rem; line-height: 1.8; color: var(--fg2); }
.status { display: inline-block; width: 0.6rem; height: 0.6rem; flex-shrink: 0; transform: translateY(-0.04em); }
.status-live { background: var(--fg); }
.status-paused { box-shadow: inset 0 0 0 1.5px var(--fg); }
.status-shelved { background: var(--muted2); }
.chip { display: inline-block; margin-right: 0.6rem; font-size: 0.78rem; letter-spacing: 0.02em; color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--fg); padding-bottom: 1px; transition: opacity 0.18s ease; }
.chip:hover { opacity: 0.55; }
.legend { margin-top: 1rem; font-size: 0.8rem; color: var(--muted); display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; }
@media (max-width: 620px) {
	.cat-head { grid-template-columns: 2rem minmax(0, 1fr) 1.2rem; row-gap: 0.15rem; }
	.cat-plus { grid-column: 3; grid-row: 1; }
	.cat-role { grid-column: 2; grid-row: 2; text-align: left; white-space: normal; }
	.cat-body > div { padding-left: 3rem; }
	.filters .ghost-link { margin-left: 0; }
}

/* ── research ── */
.paper-row { padding: 1.1rem 0; border-top: 1px solid var(--hair); }
.paper-row:first-child { border-top: 0; padding-top: 0.3rem; }
.paper-t { font-family: var(--display); font-style: italic; font-weight: 600; font-size: clamp(1.12rem, 1.5vw, 1.3rem); line-height: 1.35; letter-spacing: -0.01em; }
.paper-b { font-size: 0.74rem; letter-spacing: 0.02em; color: var(--muted); margin-top: 0.3rem; }
.paper-s { margin-top: 0.5rem; font-size: 0.97rem; line-height: 1.75; color: var(--fg2); max-width: 52rem; }
.paper-row .chip, .paper-row .ghost-link { margin-top: 0.6rem; }
.ghost-link { font-size: 0.78rem; letter-spacing: 0.02em; color: var(--fg); border-bottom: 1px solid var(--hair); padding-bottom: 1px; transition: border-color 0.18s ease; }
.ghost-link:hover { border-color: var(--fg); }
.abs { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.32s var(--ease); }
.abs > div { overflow: hidden; min-height: 0; }
.abs.open { grid-template-rows: 1fr; }
.abs p { padding: 0.6rem 0 0.2rem; font-size: 0.95rem; line-height: 1.8; color: var(--fg2); text-align: justify; hyphens: auto; max-width: 56rem; }

/* ── articles ── */
.article-row { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.4rem 1.5rem; align-items: baseline; padding: 1rem 2rem 1rem 0; border-top: 1px solid var(--hair); color: var(--fg); text-decoration: none; transition: padding-left 0.25s var(--ease); }
.article-row:first-child { border-top: 0; padding-top: 0.3rem; }
.article-row:last-child { border-bottom: 1px solid var(--hair); }
.article-row:hover { padding-left: 0.45rem; }
.article-row h3 { font-family: var(--display); font-style: italic; font-weight: 600; font-size: clamp(1.15rem, 1.7vw, 1.4rem); line-height: 1.25; letter-spacing: -0.01em; }
.article-row p { grid-column: 1; color: var(--fg2); font-size: 0.93rem; }
.article-row time { color: var(--muted); font-size: 0.74rem; letter-spacing: 0.025em; white-space: nowrap; }
.article-arrow { position: absolute; top: 50%; right: 0; color: var(--muted); transform: translateY(-50%); transition: color 0.18s ease, transform 0.18s ease; }
.article-row:hover .article-arrow { color: var(--fg); transform: translate(0.15rem, -50%); }
@media (max-width: 620px) { .article-row { grid-template-columns: 1fr; } .article-row time { grid-row: 3; } }

/* ── associations, boxed like a front page ── */
.orgs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.org { display: flex; flex-direction: column; padding: 0.3rem 1.2rem 0.6rem; border-left: 1px solid var(--hair); color: var(--fg); text-decoration: none; }
.org:first-child { border-left: 0; padding-left: 0; }
.org-logo { display: block; width: 2.8rem; height: 2.8rem; margin-bottom: 0.8rem; transition: transform 0.35s cubic-bezier(0.34,1.4,0.64,1); }
.org-logo svg { display: block; width: 100%; height: 100%; }
.org:hover .org-logo { transform: translateY(-3px) rotate(-5deg); }
.org-name { font-family: var(--display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; line-height: 1.3; }
.org-name i { font-style: normal; font-family: var(--serif); font-weight: 400; color: var(--muted); font-size: 0.85em; margin-left: 0.2rem; transition: transform 0.18s ease; display: inline-block; }
.org:hover .org-name i { transform: translate(0.12rem, -0.1rem); color: var(--fg); }
.org-desc { margin-top: 0.25rem; font-size: 0.88rem; line-height: 1.5; color: var(--fg2); }
.org-role { margin-top: 0.4rem; font-size: 0.74rem; letter-spacing: 0.02em; color: var(--muted); }
@media (max-width: 760px) {
	.orgs { grid-template-columns: 1fr 1fr; }
	.org:nth-child(odd) { border-left: 0; padding-left: 0; }
	.org:nth-child(n+3) { border-top: 1px solid var(--hair); padding-top: 1rem; }
}

/* ── off the clock ── */
.clock-wrap { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 2.4rem; align-items: start; }
.clock-fig img { display: block; width: 100%; height: auto; border: 1px solid var(--hair); }
[data-theme="dark"] .clock-fig img { filter: brightness(0.86) contrast(1.05); border-color: transparent; }
.clock-fig figcaption { margin-top: 0.4rem; font-style: italic; font-size: 0.78rem; color: var(--muted); }
.clock-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem; align-items: baseline; padding: 0.85rem 0; border-top: 1px solid var(--hair); }
.clock-row:first-child { border-top: 0; padding-top: 0.2rem; }
.clock-row:last-child { border-bottom: 1px solid var(--hair); }
.clock-t { display: block; font-family: var(--display); font-weight: 700; font-size: 1.12rem; letter-spacing: -0.01em; }
.clock-n { display: block; font-size: 0.9rem; color: var(--fg2); }
.clock-out { display: block; font-size: 0.85rem; font-style: italic; color: var(--muted); font-variant-numeric: tabular-nums; white-space: pre; overflow: hidden; text-overflow: ellipsis; }
.clock-out:empty { display: none; }
.clock-a { white-space: nowrap; }
@media (max-width: 760px) { .clock-wrap { grid-template-columns: 1fr; } .clock-fig { max-width: 24rem; } }

/* ── contact & sign-off ── */
.contact-intro { margin-bottom: 1.6rem; font-size: 1.12rem; line-height: 1.6; max-width: 38rem; color: var(--fg2); }
.c-link { display: grid; grid-template-columns: 6.5rem 1fr; align-items: baseline; gap: 1rem; padding: 0.8rem 0; border-top: 1px solid var(--hair); text-decoration: none; color: var(--fg); width: 100%; transition: padding-left 0.25s var(--ease); }
.c-link:last-child { border-bottom: 1px solid var(--hair); }
.c-link:hover { padding-left: 0.5rem; }
.c-link .dt { font-size: 0.74rem; letter-spacing: 0.03em; color: var(--muted); }
.c-link .dd { font-size: 1rem; font-weight: 500; overflow-wrap: anywhere; }
.c-link:hover .dd-v { text-decoration: underline; text-underline-offset: 3px; }
.c-hint { font-style: italic; font-weight: 400; font-size: 0.8rem; color: var(--muted); margin-left: 0.5rem; }
.signoff { margin-top: 2.6rem; display: inline-block; }
.signoff span { font-family: var(--display); font-style: italic; font-weight: 600; font-size: clamp(1.5rem, 2.6vw, 2.1rem); letter-spacing: -0.01em; }
.sig-line { display: block; width: 100%; height: 1.1rem; margin-top: 0.1rem; overflow: visible; }
.sig-line path { fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-dasharray: 340; stroke-dashoffset: 340; transition: stroke-dashoffset 1.8s var(--ease) 0.3s; }
.signoff.drawn .sig-line path { stroke-dashoffset: 0; }

/* ── colophon ── */
.colophon { margin-top: 4rem; padding-top: 1.1rem; border-top: 1px solid var(--hair); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.6rem 1.4rem; }
.colophon-line { font-style: italic; font-size: 0.82rem; color: var(--muted); }
.colophon-links { display: flex; gap: 1.2rem; }

/* ── toast ── */
.toast { position: fixed; left: 50%; bottom: 2rem; transform: translateX(-50%) translateY(1.5rem); z-index: 450; padding: 0.55rem 1.1rem; max-width: min(92vw, 34rem);
	background: var(--fg); color: var(--bg); font-size: 0.8rem; font-style: italic; text-align: center;
	opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.34,1.4,0.64,1), visibility 0s 0.3s; }
.toast.show { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.34,1.4,0.64,1); }

/* ── terminal: a quiet panel in the page's own colours ── */
.term { position: fixed; left: 50%; bottom: 0; z-index: 420; width: min(760px, 100vw); height: min(55vh, 440px);
	transform: translate(-50%, 100%); visibility: hidden;
	background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
	border: 1px solid var(--hair); border-bottom: 0; display: flex; flex-direction: column; text-transform: none;
	font-family: var(--mono); font-size: 0.78rem; color: var(--fg); transition: transform 0.35s var(--ease), visibility 0s 0.35s; }
.term.open { transform: translate(-50%, 0); visibility: visible; transition: transform 0.35s var(--ease); }
.term-h { display: flex; justify-content: space-between; padding: 0.5rem 0.9rem; border-bottom: 1px solid var(--hair); font-family: var(--serif); font-style: italic; font-size: 0.8rem; color: var(--muted); text-transform: lowercase; }
.term-out { flex: 1; overflow-y: auto; padding: 0.8rem 0.9rem 0; white-space: pre-wrap; word-break: break-word; line-height: 1.6; }
.term-out .m { color: var(--muted); }
.term-out a { color: var(--fg); }
.term-in { display: flex; gap: 0.5rem; padding: 0.55rem 0.9rem 0.85rem; }
.term-in input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--fg); font: inherit; }

/* ── sudoku overlay ── */
.modal { position: fixed; inset: 0; z-index: 430; display: grid; place-items: center; padding: 1rem; background: color-mix(in srgb, var(--bg) 93%, transparent); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
.modal[hidden] { display: none; }
.modal-box { text-align: center; }
.modal-box h3 { font-family: var(--display); font-weight: 700; font-size: 1.6rem; }
.modal-box p { font-style: italic; font-size: 0.85rem; color: var(--muted); margin-top: 0.3rem; }
.sdk { margin: 1.2rem auto 0.6rem; display: grid; grid-template-columns: repeat(4, 1fr); width: 14rem; aspect-ratio: 1; border: 1.5px solid var(--fg); background: var(--bg); }
.sdk button { font-family: var(--display); font-weight: 700; font-size: 1.7rem; text-align: center; border: 0.5px solid var(--hair); }
.sdk button:nth-child(4n+2) { border-right: 1.5px solid var(--fg); }
.sdk button:nth-child(n+5):nth-child(-n+8) { border-bottom: 1.5px solid var(--fg); }
.sdk button.given { color: var(--muted); cursor: default; }
.sdk.won button { background: var(--fg); color: var(--bg); transition: background 0.3s calc(var(--i) * 40ms), color 0.3s calc(var(--i) * 40ms); }

/* ── the fly ── */
.fly { position: fixed; left: 0; top: 0; z-index: 410; width: 26px; height: 26px; margin: -13px 0 0 -13px; padding: 0; color: var(--fg); }
.fly svg { width: 100%; height: 100%; display: block; overflow: visible; }
.fly .w { transform-origin: 15px 13px; animation: buzz 0.06s linear infinite alternate; opacity: 0.45; }
@keyframes buzz { to { transform: scaleY(0.4); } }
.fly.caught svg { animation: squash 0.6s var(--ease) forwards; }
@keyframes squash { 30% { transform: scale(1.4, 0.5); } 100% { transform: scale(0); opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
	*, *::before, *::after { animation-duration: 0.001s !important; animation-iteration-count: 1 !important; transition-duration: 0.001s !important; transition-delay: 0s !important; }
	html { scroll-behavior: auto; }
	.reveal, .hl-in, .front-fig { opacity: 1 !important; transform: none !important; }
}
@media print {
	@page { margin: 14mm; }
	html { background: #fff; }
	.page-bg, #navbar, #scrollProgress, .toast, .term, .modal, .fly, #beyond, #timeline, .colophon, .filters, .ghost-link, .cat-plus, .signoff, .front-fig { display: none !important; }
	body { color: #000; font-size: 10.5pt; }
	.paper { padding: 0; max-width: none; }
	.front { min-height: 0; }
	.headline { font-size: 30pt; }
	.sheet.pre .b.on::after { transform: scale(1); }
	.sheet.pre .box span { opacity: 1; }
	.scanline { display: none; }
	.reveal, .hl-in { opacity: 1 !important; transform: none !important; }
	.sec { margin-top: 1.4rem; grid-template-columns: 8rem 1fr; }
	.sec-label { position: static; }
	.cat-body { grid-template-rows: 1fr; }
	.cat-row[hidden] { display: block; }
	.row, .cat-row, .paper-row, .org { break-inside: avoid; }
}
	</style>
</head>
<body data-theme="light">
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
	<filter id="redInk" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.0368 0.1237 0.0125 0 0.827  0.1992 0.6701 0.0677 0 0.063  0.1892 0.6365 0.0643 0 0.110  0 0 0 1 0" /></filter>
	<filter id="pencil" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="2.2" xChannelSelector="R" yChannelSelector="G" /></filter>
</svg>
<div class="page-bg" aria-hidden="true"></div>
<div id="scrollProgress" aria-hidden="true"></div>

<nav id="navbar">
	<a href={`${A}/`} class="nav-brand">utku&rsquo;s&nbsp;space</a><span class="nav-sub">/ cv</span>
	<div class="nav-links">
