			{cats.map((c) => (
				<div class="work-col">
					<h3 class="work-cat"><Fragment set:html={c.icon} />{c.key}<span class="work-count">{c.items.length}</span></h3>
					{c.items.map((p) => (
						<article class="proj">
							<p class="proj-t"><span class={`status status-${p.status}`} aria-label={statusLabel[p.status]}></span>{p.name}</p>
							<p class="proj-b">{p.role}</p>
							<div class="proj-d" set:html={absolute(p.body)} />
						</article>
					))}
				</div>
			))}
		</div>
		<p class="legend"><span class="status status-live"></span> active &nbsp;·&nbsp; <span class="status status-paused"></span> paused &nbsp;·&nbsp; <span class="status status-shelved"></span> shelved</p>
	</section>

	<section id="research" class="section reveal">
		<div class="rule-head"><h2 class="rule-head-label">research</h2></div>
		<div class="rows">
			{papers.map((p, i) => (
				<article class="paper-row">
					<p class="paper-t">{p.name}</p>
					<p class="paper-b">{p.journal ? `${p.journal}, ${p.publisher}` : p.venue} &middot; {p.year}{p.coAuthors && ` · with ${p.coAuthors.join(', ')}`}</p>
