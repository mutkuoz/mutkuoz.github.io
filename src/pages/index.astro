---
// utku.space — the homepage, printed as an edition of the utku times (news.utku.space/times):
// cream broadsheets on the utku.space fresco, a blackletter flag, ruled columns, and the
// numbers listed like a markets table. three sheets: a1 the front page, a2 the record and
// the work, a3 research, interests, puzzles and classifieds.
// everything (css, js, data) is inline and every asset loads from utku.space by absolute
// url, so the built html also runs unchanged as the copy served at cv.utku.space.
// the search-engine metadata comes from src/lib/schema.ts. the previous homepage design is
// parked, unbuilt, in archive/classic-homepage/.
import { papers } from '../data/research';
import { projects, categories, categoryIcon, statusLabel } from '../data/projects';
import { associations } from '../data/associations';
import { honours } from '../data/honours';
import { SITE, articleUrl, formatDate, getArticles } from '../lib/site';
import { SAME_AS, buildSchema } from '../lib/schema';

const A = SITE;
// https://utku.space/ (the cv.utku.space copy points here too)
const canonical = new URL(Astro.url.pathname, SITE).href;
const title = 'Mehmet Utku Öztürk — unpredictable, unsatisfied, unconventional';
const description =
	'Mehmet Utku Öztürk is a machine learning developer and AI researcher in Ankara, Türkiye: technical co-founder of turkhukuk.ai, first author of HukukBERT, author of LLM Electrodes, and creator of FlyDOOM. His record, printed as an edition of The Utku Times.';
const articles = await getArticles();
const schema = buildSchema({ canonical, title, description, articles });

// the paper is set in sentence case; the shared data is lowercase, so it gets its capitals here
const TERMS: [RegExp, string][] = (
	[
		['international association for artificial intelligence and law', 'International Association for Artificial Intelligence and Law'],
		['project: turkic blue', 'Project: Turkic Blue'],
		['mensa international', 'Mensa International'],
		['save the children', 'Save the Children'],
		['hugging face', 'Hugging Face'],
		['lady lovelace', 'Lady Lovelace'],
		['qwen3.5-4b', 'Qwen3.5-4B'],
		['tübitak', 'TÜBİTAK'], ['bilsem', 'BİLSEM'], ['iaail', 'IAAIL'], ['mlp', 'MLP'], ['iud', 'IUD'],
		['21m', '21M'], ['ai', 'AI'], ['llm', 'LLM'], ['llms', 'LLMs'], ['iq', 'IQ'], ['mit', 'MIT'], ['captcha', 'CAPTCHA'],
		['doom', 'Doom'], ['github', 'GitHub'], ['pypi', 'PyPI'], ['python', 'Python'], ['typescript', 'TypeScript'], ['markdown', 'Markdown'],
		['turkish', 'Turkish'], ['turkic', 'Turkic'], ['türkiye', 'Türkiye'], ['wikipedia', 'Wikipedia'], ['hungarian', 'Hungarian'], ['july', 'July']
	] as [string, string][]
).map(([k, v]) => [new RegExp(`(?<![\\p{L}\\p{N}.])${k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\p{L}\\p{N}])`, 'gu'), v]);
function newsCase(html: string) {
	let cap = true, linkStart = false;
	return html
		.split(/(<[^>]+>|&[a-z#0-9]+;)/gi)
		.map((part) => {
			if (part.startsWith('<a')) { cap = false; linkStart = true; }
			if (!part || part.startsWith('<') || /^&[a-z#0-9]+;$/i.test(part)) return part;
			if (linkStart) { linkStart = false; if (!/^\s*[\p{L}\p{N}-]+\.[\p{L}]/u.test(part)) cap = true; }
			const text = TERMS.reduce((t, [re, v]) => t.replace(re, v), part);
			let out = '';
			for (let i = 0; i < text.length; i++) {
				const ch = text[i];
				if (cap && /\p{L}/u.test(ch)) { out += ch.toUpperCase(); cap = false; continue; }
				if (cap && /\p{N}/u.test(ch)) cap = false;
				out += ch;
				if (/[.!?]/.test(ch) && (i + 1 >= text.length || /\s/.test(text[i + 1]))) cap = true;
			}
			return out;
		})
		.join('');
}
// project bodies link relative to utku.space; on cv.utku.space they need the full origin
const absolute = (html: string) => html.replace(/href="\//g, `href="${SITE}/`);
const NAMES: Record<string, string> = { 'llm electrodes': 'LLM Electrodes', flydoom: 'FlyDOOM', octapar: 'Octapar', topazius: 'Topazius', labgpt: 'LabGPT', 'clade ai': 'Clade AI', 'mentoring @ bilsem': 'Mentoring at BİLSEM', sorubot: 'Sorubot', 'a.d.a': 'A.D.A', 'founder @ ananas studios': 'Ananas Studios', shoelace: 'Shoelace' };
const pname = (n: string) => NAMES[n] ?? n;
const CATS: Record<string, string> = { 'open-source': 'Open source', work: 'Work', unpublished: 'Unpublished' };
const cats = categories.map((key) => ({ key, title: CATS[key] ?? key, icon: categoryIcon[key], items: projects.filter((p) => p.category === key) }));
const firstLink = (html: string) => (html.match(/href="([^"]+)"/) ?? [])[1];

// live age: the integer flips at midnight, 29 november, istanbul time (utc+2 in winter until 2016, utc+3 since)
const bday = (y: number) => Date.UTC(y, 10, 29) - (y <= 2015 ? 2 : 3) * 3600e3;
const ageAt = (now: number) => {
	let y = new Date(now).getUTCFullYear(), last = bday(y);
	if (now < last) last = bday(--y);
	return (y - 2008) + (now - last) / (bday(y + 1) - last);
};
const NOW = Date.now();
const roman = (n: number) => ([[10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']] as [number, string][]).reduce((s, [v, r]) => { while (n >= v) { s += r; n -= v; } return s; }, '');
const age0 = ageAt(NOW);
const edition = { vol: roman(Math.floor(age0)), no: Math.floor((age0 % 1) * 365.25) + 1 };
const dateline = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Istanbul', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(NOW);
const CODING_SINCE = 2016;
const sat = { math: 800, rw: 710 };

// the utku index: the numbers, listed like a markets table
const index = [
	{ k: 'Age', v: age0.toFixed(9), id: 'idxAge', chg: 'live', cls: 'up' },
	{ k: 'Years coding', v: String(new Date(NOW).getFullYear() - CODING_SINCE), id: 'idxDev', chg: `since ’${String(CODING_SINCE).slice(2)}`, cls: 'up' },
	{ k: 'GPA, unweighted', v: '4.00', chg: 'max', cls: 'max' },
	{ k: 'SAT math', v: String(sat.math), chg: 'max', cls: 'max' },
	{ k: 'SAT R&W', v: String(sat.rw), chg: '', cls: '' },
	{ k: 'AP Calculus AB', v: '5', chg: 'max', cls: 'max' },
	{ k: 'AP Calculus BC', v: '5', chg: 'max', cls: 'max' },
	{ k: 'AP CS Principles', v: '5', chg: 'max', cls: 'max' },
	{ k: 'AP CS A', v: '5', chg: 'max', cls: 'max' },
	{ k: 'Papers', v: String(papers.length), chg: '', cls: '' }
];


// the scrubbable timeline: one entry per year, empty years get a line of their own
const FIRST = 2008, LAST = 2026;
const record: Record<number, string[]> = {
	2026: ['Co-founded turkhukuk.ai, legaltech for Turkish lawyers', 'HukukBERT published, first author', 'LLM Electrodes: one neuron, a new personality', 'FlyDOOM: a fruit fly connectome playing Doom', '007captcha, Topazius, turkic-relevance-laya'],
	2025: ['LabGPT, TÜBİTAK-backed medical R&D', 'Octapar, the platform and the paper'],
	2024: ['Started mentoring at BİLSEM', '“Streaming Intelligence” paper, with Plawlabs'],
	2023: ['eTwinning National Quality Label: “Particle Physics and CERN”', 'Co-founded Clade AI', 'trstemmer, on PyPI'],
	2022: ['Started on machine learning, at 13', 'Sorubot, and a first LLM fine-tune'],
	2020: ['C++ and C#, by 11', 'A.D.A, a deterministic personal assistant', 'Shoelace, a peer-based encryption algorithm'],
	2019: ['Founded Ananas Studios, an indie game studio'],
	2018: ['eTwinning Pupil Quality Label'],
	2017: ['First small apps and scripts, at 8'],
	2008: ['Born, 29 November']
};
const years = Array.from({ length: LAST - FIRST + 1 }, (_, i) => FIRST + i);

// what the scripts know
const cvData = {
	email: 'm@utku.space',
	sat,
	gpa: '4.00 unweighted',
	ap: { 'calculus ab': 5, 'calculus bc': 5, 'cs principles': 5, 'cs a': 5 },
	papers: 4,
	codingSince: CODING_SINCE,
	first: FIRST,
	last: LAST,
	record,
	projects: projects.map((p) => ({ name: pname(p.name), category: p.category, status: statusLabel[p.status], role: p.role, link: firstLink(absolute(p.body)) })),
	papers_: papers.map((p) => ({ name: p.name, year: p.year, venue: p.journal ?? p.venue, link: p.links[0]?.url })),
	honours: honours.map((h) => `${h.year} · ${h.title}`)
};
const json = JSON.stringify(cvData).replace(/</g, '\\u003c');

const head = `
@font-face { font-family: 'Newsreader'; font-style: normal; font-weight: 400 600; font-display: swap; src: url('${A}/fonts/newsreader-normal-latin.woff2') format('woff2'); }
@font-face { font-family: 'Newsreader'; font-style: italic; font-weight: 400 500; font-display: swap; src: url('${A}/fonts/newsreader-italic-latin.woff2') format('woff2'); }
@font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 500 800; font-display: swap; src: url('${A}/fonts/playfair-display-normal-latin.woff2') format('woff2'); }
@font-face { font-family: 'Playfair Display'; font-style: italic; font-weight: 500 600; font-display: swap; src: url('${A}/fonts/playfair-display-italic-latin.woff2') format('woff2'); }
@font-face { font-family: 'UnifrakturCook'; font-style: normal; font-weight: 700; font-display: swap; src: url('${A}/fonts/unifrakturcook-bold-latin.woff2') format('woff2'); }
.page-bg { background-image: url('${A}/utku-bg.png'); background-image: image-set(url('${A}/utku-bg.webp') type('image/webp'), url('${A}/utku-bg.png') type('image/png')); }`;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonical} />
	<meta name="author" content="Mehmet Utku Öztürk" />
	<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
	<link rel="sitemap" type="application/xml" href={`${A}/sitemap.xml`} />
	<link rel="alternate" type="application/rss+xml" href={`${A}/rss.xml`} title="utku&rsquo;s space — articles" />
	<link rel="alternate" type="text/plain" href={`${A}/llms.txt`} title="plain-text profile for language models" />
	{SAME_AS.map((url) => <link rel="me" href={url} />)}
	<meta name="theme-color" content="#fbfaf6" id="themeColor" />
	<link rel="icon" type="image/svg+xml" href={`${A}/favicon.svg`} />
	<link rel="preload" as="font" type="font/woff2" crossorigin href={`${A}/fonts/unifrakturcook-bold-latin.woff2`} />
	<link rel="preload" as="font" type="font/woff2" crossorigin href={`${A}/fonts/newsreader-normal-latin.woff2`} />
	<link rel="preload" as="font" type="font/woff2" crossorigin href={`${A}/fonts/playfair-display-normal-latin.woff2`} />
	<meta property="og:type" content="profile" />
	<meta property="og:site_name" content="The Utku Times" />
	<meta property="og:locale" content="en_GB" />
	<meta property="og:url" content={canonical} />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:image" content={`${A}/desk.webp`} />
	<meta property="og:image:width" content="1024" />
	<meta property="og:image:height" content="682" />
	<meta property="og:image:alt" content="Ink illustration of a cluttered desk, and Mehmet Utku Öztürk asleep on the floor beneath it" />
	<meta property="profile:first_name" content="Mehmet Utku" />
	<meta property="profile:last_name" content="Öztürk" />
	<meta property="profile:username" content="mutkuoz" />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:site" content="@mutkuoz" />
	<meta name="twitter:creator" content="@mutkuoz" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={`${A}/desk.webp`} />
	<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
	<style is:inline set:html={head}></style>
	<noscript><style is:inline>.reveal { opacity: 1; transform: none; }</style></noscript>
	<script is:inline>
	/* the saved theme, before first paint — same storage key as utku.space and news.utku.space */
	(function () { try { if (localStorage.getItem('theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); } catch (e) {} })();
	</script>
	<script is:inline>
	(function () {
		try {
			if (sessionStorage.getItem('introSeen')) return;
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			if (navigator.webdriver || location.hash) return;
			document.documentElement.classList.add('intro-on');
		} catch (e) {}
	})();
	</script>
	<style is:inline>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
/* ── the utku times palette ── */
:root {
	--paper: #fbfaf6; --ink: #121212; --ink2: #333; --muted: #6b6860; --rule: #121212; --hair: rgba(18,18,18,.22);
	--sheet: rgba(251,250,246,.5); --tint: rgba(18,18,18,.06); --pencil: #1f3a8a; --desk: #e4e0d4; --bar: rgba(251,250,246,.5);
	/* liquid glass: a frosted pane, a bright rim, light caught along the top edge, a soft drop shadow */
	--glass-blur: blur(16px) saturate(1.6); --glass-edge: rgba(255,255,255,.75); --glass-shine: rgba(255,255,255,.55); --glass-rim: rgba(255,255,255,.9);
	--shadow: inset 0 1px 0 rgba(255,255,255,.8), inset 0 0 0 1px rgba(255,255,255,.35), 0 1px 2px rgba(0,0,0,.06), 0 14px 44px rgba(0,0,0,.16); --img-filter: none; --desk-filter: none;
	--serif: 'Newsreader', Georgia, 'Times New Roman', serif;
	--display: 'Playfair Display', Georgia, 'Times New Roman', serif;
	--black: 'UnifrakturCook', 'Playfair Display', Georgia, serif;
	--mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
	--ease: cubic-bezier(0.4, 0, 0.2, 1);
	--out: cubic-bezier(0.2, 0.7, 0.1, 1);
}
/* the night edition: warm white ink on a sheet of smoked glass, so the fresco, dimmed exactly as on
   utku.space, shows through the whole page the way it does there */
[data-theme="dark"] {
	--paper: #111110; --sheet: rgba(17,17,16,.42); --ink: #ece8df; --ink2: #c9c5bc; --muted: #8f8b82; --rule: #ece8df; --hair: rgba(236,232,223,.2);
	--tint: rgba(236,232,223,.07); --pencil: #9db7ff; --desk: #000; --bar: rgba(10,10,9,.45);
	--glass-blur: blur(12px) saturate(1.3); --glass-edge: rgba(255,255,255,.14); --glass-shine: rgba(255,255,255,.07); --glass-rim: rgba(255,255,255,.28);
	--shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 0 0 1px rgba(255,255,255,.06), 0 14px 44px rgba(0,0,0,.5); --img-filter: brightness(.86) contrast(1.05);
	--desk-filter: grayscale(1) brightness(.13) contrast(1.2);
}
/* konami: red ink */
[data-konami] { --ink: #d3101c; --ink2: rgba(211,16,28,.86); --muted: rgba(211,16,28,.66); --rule: #d3101c; --hair: rgba(211,16,28,.3); --desk-filter: url(#redInk); }
[data-konami][data-theme="dark"] { --ink: #ff4d55; --ink2: rgba(255,77,85,.86); --muted: rgba(255,77,85,.66); --rule: #ff4d55; --hair: rgba(255,77,85,.3); --desk-filter: grayscale(1) brightness(.13) contrast(1.2) url(#redInk); }
.plate img, .leisure figure img { filter: var(--img-filter); }
[data-konami] img { filter: url(#redInk); }

html { background: var(--desk); transition: background-color .35s ease; }
body { font-family: var(--serif); color: var(--ink); line-height: 1.42; -webkit-font-smoothing: antialiased; overflow-x: clip; }
a { color: inherit; }
button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; text-align: inherit; }
button:focus-visible, a:focus-visible, [tabindex]:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
::selection { background: var(--ink); color: var(--paper); }

/* ── the desk: the utku.space fresco ── */
.page-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; background-position: center; background-size: cover; background-repeat: no-repeat; filter: var(--desk-filter); transition: filter .35s ease; }

/* ── toolbar (screen only) ── */
.bar { position: sticky; top: 0; z-index: 50; display: flex; gap: 1.2rem; align-items: center; justify-content: space-between;
	padding: .55rem 1.2rem; background: var(--bar); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); border-bottom: 1px solid var(--glass-edge); box-shadow: 0 1px 0 var(--hair); font-size: .86rem; }
.bar a, .bar button { color: var(--ink); text-decoration: none; }
.bar a:hover, .bar button:hover { text-decoration: underline; text-underline-offset: 3px; }
.bar .brand { font-family: var(--display); font-style: italic; font-weight: 600; white-space: nowrap; }
.bar nav { display: flex; align-items: center; gap: 1.2rem; }
.lamp { display: inline-flex; width: 1.7rem; height: 1.7rem; align-items: center; justify-content: center; border: 1px solid var(--hair); border-radius: 50%; }
.lamp svg { width: .85rem; height: .85rem; }
.lamp:hover { text-decoration: none !important; border-color: var(--ink); }
html:not([data-theme="dark"]) .lamp .icon-moon, [data-theme="dark"] .lamp .icon-sun { display: none; }
@media (max-width: 860px) { .bar .opt { display: none; } .bar nav { gap: .9rem; } }
@media (max-width: 560px) { .bar .opt-s { display: none; } }

/* ── the music player, as on utku.space: a vinyl record that turns while it plays ── */
.bar-l { display: flex; align-items: center; min-width: 0; }
.player { display: flex; align-items: center; gap: .55rem; min-width: 0; margin-left: .9rem; padding-left: .9rem; height: 1.8rem; border-left: 1px solid var(--hair); }
.disc { position: relative; flex: none; width: 2rem; height: 2rem; margin: 0 .1rem; padding: 0; border-radius: 50%; box-shadow: 0 0 0 1px var(--hair), 0 1px 3px rgba(0,0,0,.25); transition: transform .15s ease, box-shadow .2s ease; }
.disc:hover { transform: scale(1.06); box-shadow: 0 0 0 1px var(--ink), 0 2px 6px rgba(0,0,0,.3); }
.disc:active { transform: scale(.94); }
.disc-icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #0c0c0c; pointer-events: none; transition: opacity .2s ease; }
.disc-icon svg { width: .62rem; height: .62rem; padding: .11rem; border-radius: 50%; background: #f2eee6; }
.disc-icon .i-play { transform: translateX(.5px); }
.player.playing .disc-icon { opacity: 0; }
.player.playing .disc:hover .disc-icon, .player.playing .disc:focus-visible .disc-icon { opacity: 1; }
.disc-vinyl { display: block; width: 100%; height: 100%; animation: disc-spin 1.8s linear infinite; animation-play-state: paused; }
.player.playing .disc-vinyl { animation-play-state: running; }
.disc-sheen { position: absolute; inset: 0; border-radius: 50%; pointer-events: none;
	background: conic-gradient(from 20deg, transparent 0 8%, rgba(255,255,255,.22) 13%, transparent 20% 52%, rgba(255,255,255,.16) 60%, transparent 68%);
	-webkit-mask: radial-gradient(circle, transparent 0 41%, #000 42%); mask: radial-gradient(circle, transparent 0 41%, #000 42%); }
@keyframes disc-spin { to { transform: rotate(360deg); } }
.player-controls { display: flex; align-items: center; gap: .1rem; flex: none; }
.player-btn { flex: none; display: flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; color: var(--ink2); transition: color .18s ease, background-color .18s ease, transform .12s ease; }
.bar .player-btn:hover { color: var(--ink); background: var(--tint); text-decoration: none; }
.player-btn:active { transform: scale(.9); }
.player-btn svg { width: .9rem; height: .9rem; }
.player .i-pause, .player.playing .i-play { display: none; }
.player.playing .i-pause { display: block; }
.player-track { display: flex; flex-direction: column; justify-content: center; width: 9.5rem; min-width: 0; line-height: 1.15; }
.player-title, .player-artist { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.player-title { font-family: var(--display); font-style: italic; font-weight: 600; font-size: .82rem; color: var(--ink); }
.player-artist { font-size: .68rem; letter-spacing: .02em; color: var(--muted); }
.player-vol { display: flex; align-items: center; gap: .2rem; flex: none; }
.player-mute svg { width: 1rem; height: 1rem; }
.player-mute .cross, .player.muted .player-mute .wave { display: none; }
.player.muted .player-mute .cross { display: inline; }
.vol-wedge { position: relative; display: block; width: 3.2rem; height: .9rem; }
.vol-wedge::before { content: ''; position: absolute; inset: 0; clip-path: polygon(0 100%, 100% 100%, 100% 0); background: linear-gradient(90deg, var(--ink) var(--v), color-mix(in srgb, var(--ink) 28%, transparent) var(--v)); }
.player.muted .vol-wedge::before { opacity: .4; }
.vol-wedge input { position: absolute; inset: -.3rem 0; width: 100%; height: calc(100% + .6rem); margin: 0; opacity: 0; cursor: pointer; }
.vol-wedge:has(input:focus-visible) { outline: 2px solid var(--ink); outline-offset: 3px; }
.player-yt { position: fixed; left: -9999px; top: 0; width: 200px; height: 200px; overflow: hidden; pointer-events: none; opacity: 0; }
[data-konami] .disc { filter: url(#redInk); }
@media (max-width: 1000px) { .player-vol { display: none; } }
@media (max-width: 560px) { .player { margin-left: .6rem; padding-left: .6rem; gap: .3rem; } .player-track { width: 5.2rem; } }
@media (max-width: 380px) { .player-track { width: 3.8rem; } .bar .brand { font-size: .92rem; } }

/* ── the sheets ── */
.wrap { position: relative; z-index: 1; padding: 1.6rem 1rem 2rem; }
.sheet { position: relative; isolation: isolate; background: var(--sheet); max-width: 62rem; margin: 0 auto 2.2rem; padding: 1.5rem 1.6rem 1rem; color: var(--ink);
	border-radius: 18px; backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
	box-shadow: var(--shadow); scroll-margin-top: 3.4rem; transition: background-color .35s ease, color .35s ease; }
/* the light on the glass: a broad sheen that drifts toward the pointer, under the type */
.sheet::before { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none;
	background: radial-gradient(48rem circle at var(--mx, 18%) var(--my, -8%), var(--glass-shine), transparent 46%),
		linear-gradient(160deg, var(--glass-shine), transparent 22%); transition: background-position .2s ease; }
/* the rim: brighter where the light hits, fading round the far side */
.sheet::after { content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
	background: linear-gradient(150deg, var(--glass-rim), var(--glass-edge) 18%, transparent 42%, transparent 62%, var(--glass-edge) 88%, var(--glass-rim));
	-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
.plate, .leisure figure img { border-radius: 4px; }
/* no backdrop blur to lean on: thicken the glass so the type stays readable */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
	:root { --sheet: rgba(251,250,246,.94); --bar: rgba(228,224,212,.94); }
	[data-theme="dark"] { --sheet: rgba(17,17,16,.9); --bar: rgba(10,10,9,.92); }
}
html:not(.intro-on) .sheet.land { animation: land .9s var(--out) both; }
@keyframes land { from { opacity: 0; transform: translateY(22px) rotate(-.5deg); } }
@media (max-width: 560px) { .wrap { padding: 1rem .5rem 1.5rem; } .sheet { padding: 1.1rem 1rem .9rem; border-radius: 14px; } }

.flag { text-align: center; }
.nameplate { font-family: var(--black); font-weight: 700; font-size: clamp(2.8rem, 10.5vw, 5.8rem); line-height: 1.02; margin: 0 0 .2rem; letter-spacing: .005em; }
.motto { margin-bottom: .45rem; font-family: var(--display); font-style: italic; font-weight: 500; font-size: clamp(.95rem, 1.6vw, 1.1rem); color: var(--ink2); }
.motto .word { display: inline-block; }
.un { font-style: italic; font-weight: 600; color: var(--ink); display: inline-block; border-bottom: 1px dotted var(--hair); line-height: 1.1; }
.un:hover { border-bottom-color: var(--ink); }
.word.off .un { animation: unfall 1.4s var(--ease) forwards; }
.word.off .rest { text-decoration: line-through; }
@keyframes unfall { 30% { transform: translate(-.1em, .4em) rotate(-25deg); opacity: .8; } 60% { transform: translate(-.2em, 1.4em) rotate(-70deg); opacity: 0; } 61% { transform: translateY(-.6em); opacity: 0; } 100% { transform: none; opacity: 1; } }
.folio-bar { display: flex; justify-content: space-between; gap: .6rem; padding: .3rem 0; border-top: 3px double var(--rule); border-bottom: 1px solid var(--rule); font-size: .68rem; letter-spacing: .09em; text-transform: uppercase; }
@media (max-width: 560px) { .folio-bar .opt { display: none; } }

.cols { display: grid; grid-template-columns: minmax(0, 2.15fr) minmax(0, 1fr); margin-top: .6rem; }
.main { padding-right: 1.1rem; border-right: 1px solid var(--rule); }
.side { padding-left: 1.1rem; }
@media (max-width: 760px) { .cols { grid-template-columns: 1fr; } .main { padding-right: 0; border-right: 0; } .side { padding-left: 0; margin-top: 1.2rem; border-top: 1px solid var(--rule); padding-top: .8rem; } }

.kicker { font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink2); font-weight: 600; }
.lead-h { font-family: var(--display); font-weight: 800; font-size: clamp(1.8rem, 5.2vw, 2.9rem); line-height: 1.04; letter-spacing: -.01em; margin: .15rem 0 .3rem; }
.deck { font-style: italic; font-size: 1.02rem; color: var(--ink2); margin-bottom: .6rem; }
.photo { margin: .3rem 0 .45rem; }
.plate { position: relative; aspect-ratio: 16 / 8.5; overflow: hidden; background: #111; }
.plate img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 62%; transform: scale(1.04); transition: transform 6s var(--out); }
.photo:hover .plate img { transform: scale(1.09); }
.photo figcaption { font-size: .68rem; color: var(--muted); margin-top: .25rem; line-height: 1.3; }
.photo .credit { font-style: italic; }

.lead-body { column-count: 2; column-gap: 1.1rem; column-rule: 1px solid var(--hair); text-align: justify; hyphens: auto; font-size: .92rem; line-height: 1.38; }
.lead-body p { margin-bottom: .5rem; text-indent: 1em; }
.lead-body p:first-child { text-indent: 0; }
.lead-body p:first-child::first-letter { font-family: var(--display); font-weight: 800; float: left; font-size: 3.1em; line-height: .82; padding: .04em .08em 0 0; }
@media (max-width: 560px) { .lead-body { column-count: 1; } }
.nb { hyphens: none; white-space: nowrap; }
.src { font-size: .64rem; color: var(--muted); margin: .3rem 0 .5rem; border-bottom: 1px solid var(--rule); padding-bottom: .5rem; }
.src a { text-decoration: none; border-bottom: 1px solid var(--hair); }

.secondary { display: grid; grid-template-columns: 1fr 1fr; }
.story { padding: 0 .9rem 0 0; font-size: .86rem; line-height: 1.36; text-align: justify; hyphens: auto; }
.story + .story { padding: 0 0 0 .9rem; border-left: 1px solid var(--hair); }
.story h3 { font-family: var(--display); font-size: 1.12rem; line-height: 1.12; margin: .1rem 0 .3rem; text-align: left; }
.story p { margin-bottom: .4rem; }
@media (max-width: 560px) { .secondary { grid-template-columns: 1fr; } .story + .story { padding: .6rem 0 0; border-left: 0; border-top: 1px solid var(--hair); margin-top: .6rem; } .story { padding-right: 0; } }
.chip { text-decoration: none; border-bottom: 1px solid var(--hair); font-size: .82em; font-style: italic; color: var(--ink2); white-space: nowrap; transition: border-color .18s ease; }
.chip:hover { border-color: var(--ink); }

/* sidebar */
.side h5 { font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; border-top: 3px double var(--rule); border-bottom: 1px solid var(--rule); padding: .22rem 0; margin: .8rem 0 .35rem; }
.side h5:first-child { margin-top: 0; }
.side table { width: 100%; border-collapse: collapse; font-size: .8rem; font-variant-numeric: tabular-nums lining-nums; }
.mkt th { text-align: left; font-weight: 500; padding: .13rem 0; }
.mkt td { text-align: right; padding: .13rem 0 .13rem .4rem; font-weight: 600; white-space: nowrap; }
#idxAge { font-variant-numeric: tabular-nums lining-nums; letter-spacing: -.01em; }
.mkt tr { border-bottom: 1px dotted var(--hair); transition: background-color .2s ease; }
.mkt tr:hover { background: var(--tint); }
.mkt .chg { font-weight: 500; font-style: italic; min-width: 3.4rem; }
.mkt .up::before { content: '▲ '; font-size: .6em; vertical-align: .1em; font-style: normal; }
.mkt .max::before { content: '★ '; font-size: .7em; vertical-align: .05em; font-style: normal; }
.small { font-size: .68rem; color: var(--muted); margin-top: .25rem; line-height: 1.32; }
.inside { list-style: none; font-size: .78rem; }
.inside li { border-top: 1px solid var(--hair); }
.inside li:first-child { border-top: 0; }
.inside a { display: grid; grid-template-columns: 2rem 1fr; gap: .3rem; padding: .32rem 0; text-decoration: none; transition: padding-left .25s var(--ease); }
.inside a:hover { padding-left: .25rem; }
.inside a:hover strong { text-decoration: underline; text-underline-offset: 2px; }
.inside b { font-size: .68rem; letter-spacing: .06em; }
.inside strong { display: block; font-weight: 600; line-height: 1.22; }
.inside span { color: var(--muted); font-size: .72rem; line-height: 1.25; display: block; }


.folio { display: flex; justify-content: space-between; gap: .6rem; margin-top: .55rem; padding-top: .3rem; border-top: 1px solid var(--rule); font-size: .6rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink2); }

/* ── inside pages ── */
.back-head { display: flex; justify-content: space-between; align-items: baseline; gap: .6rem; padding-bottom: .35rem; border-bottom: 3px double var(--rule); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; }
.mini-flag { font-family: var(--black); font-size: 1.7rem; letter-spacing: 0; text-transform: none; line-height: 1; white-space: nowrap; }
@media (max-width: 560px) { .back-head .opt { display: none; } }
.puz-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .6rem; border-bottom: 1px solid var(--rule); padding-bottom: .2rem; margin-bottom: .5rem; scroll-margin-top: 3.4rem; }
.puz-head h3 { font-family: var(--display); font-size: 1.15rem; white-space: nowrap; }
.puz-head span { font-size: .64rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); text-align: right; }
.puz-head .status { margin: 0 .15rem 0 .5rem; }
.block { margin-top: 1.1rem; }
.split { display: grid; gap: 0 1.1rem; margin-top: 1.1rem; }
.split > * + * { padding-left: 1.1rem; border-left: 1px solid var(--hair); }
.split-a { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
.split-b { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
.split-c { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); }
@media (max-width: 760px) { .split { grid-template-columns: 1fr; } .split > * + * { padding-left: 0; border-left: 0; margin-top: 1.1rem; } }

.bsec h4 { font-family: var(--display); font-size: 1rem; font-weight: 800; letter-spacing: .01em; border-top: 3px double var(--rule); border-bottom: 1px solid var(--rule); padding: .18rem 0; margin-bottom: .1rem; break-after: avoid; display: flex; align-items: center; gap: .4rem; }
.bsec h4 svg { width: .95rem; height: .95rem; flex: none; }
.bsec h4 small { margin-left: auto; font-family: var(--serif); font-weight: 400; font-size: .7rem; color: var(--muted); }
.bsec ul { list-style: none; }
.bsec li { break-inside: avoid; font-size: .84rem; line-height: 1.34; text-align: justify; hyphens: auto; padding: .38rem 0; border-top: 1px solid var(--hair); color: var(--ink2); }
.bsec li:first-child { border-top: 0; }
.bsec li p { display: inline; }
.bsec li strong { color: var(--ink); font-weight: 700; }
.hon li { display: grid; grid-template-columns: 4.6rem minmax(0, 1fr); gap: .5rem; text-align: left; }
.hon li > b { font-size: .7rem; letter-spacing: .04em; color: var(--ink); padding-top: .1rem; font-variant-numeric: lining-nums; }
.hon a { text-decoration: none; border-bottom: 1px solid var(--hair); }
.hon a:hover { border-color: var(--ink); }
.work-cols { column-count: 3; column-gap: 1.1rem; column-rule: 1px solid var(--hair); }
@media (max-width: 900px) { .work-cols { column-count: 2; } }
@media (max-width: 560px) { .work-cols { column-count: 1; } }
.work-cols .bsec { margin-bottom: .7rem; }
.work-cols .bsec li { break-inside: avoid; }
.pn { display: inline-flex; align-items: baseline; gap: .35rem; font-family: var(--display); font-size: .98rem; }
.role { font-style: italic; color: var(--muted); font-size: .92em; }
.status { display: inline-block; width: .52rem; height: .52rem; flex: none; transform: translateY(-.02em); }
.status-live { background: var(--ink); }
.status-paused { box-shadow: inset 0 0 0 1.4px var(--ink); }
.status-shelved { background: var(--hair); }

/* the timeline, as a newspaper chart */
.tl-axis { position: relative; display: grid; height: 3.4rem; margin-top: .3rem; border-bottom: 1.5px solid var(--ink); cursor: ew-resize; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
.tl-tick { position: relative; height: 100%; }
.tl-tick::before { content: ''; position: absolute; left: 50%; bottom: 0; width: 1px; height: .5rem; background: var(--hair); transition: height .3s var(--out), background .3s ease; }
.tl-tick.has::before { height: 1.15rem; background: var(--ink); }
.tl-tick.on::before { height: 2.2rem; width: 2px; margin-left: -.5px; background: var(--ink); }
.tl-tick span { position: absolute; left: 50%; top: 0; transform: translateX(-50%); font-size: .62rem; letter-spacing: .02em; color: var(--muted); white-space: nowrap; opacity: 0; transition: opacity .2s ease; }
.tl-tick.has span { opacity: 1; }
.tl-tick.on span { opacity: 1; color: var(--ink); font-weight: 700; }
.tl-ends { display: flex; justify-content: space-between; margin-top: .25rem; font-size: .62rem; letter-spacing: .08em; color: var(--muted); }
.tl-panel { display: grid; grid-template-columns: 6.6rem minmax(0, 1fr); gap: .3rem 1rem; align-items: start; margin-top: .7rem; min-height: 7.6rem; }
.tl-year { font-family: var(--display); font-weight: 800; font-size: 2.6rem; line-height: .95; letter-spacing: -.02em; font-variant-numeric: lining-nums; }
.tl-age { font-style: italic; font-size: .78rem; color: var(--muted); margin-bottom: .3rem; }
.tl-list { list-style: none; font-size: .86rem; line-height: 1.34; }
.tl-list li { padding: .2rem 0; border-top: 1px solid var(--hair); animation: rise .45s var(--out) both; animation-delay: calc(var(--k) * 55ms); }
.tl-list li:first-child { border-top: 0; }
.tl-list li.quiet { font-style: italic; color: var(--muted); }
.tl-year.flip { animation: rise .4s var(--out); }
@keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@media (max-width: 560px) { .tl-tick.has span { opacity: 0; } .tl-tick.on span { opacity: 1; } .tl-panel { grid-template-columns: 1fr; } }

/* research: two by two */
.papers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.paper-col { padding: 0 0 .8rem; font-size: .84rem; line-height: 1.36; }
.paper-col:nth-child(odd) { padding-right: .9rem; }
.paper-col:nth-child(even) { padding-left: .9rem; border-left: 1px solid var(--hair); }
.paper-col:nth-child(n+3) { padding-top: .7rem; border-top: 1px solid var(--hair); }
.paper-col h3 { font-family: var(--display); font-size: 1.02rem; line-height: 1.15; margin: .15rem 0 .3rem; }
.paper-col .by { font-style: italic; font-size: .76rem; color: var(--muted); margin-bottom: .3rem; }
.paper-col p { text-align: justify; hyphens: auto; margin-bottom: .35rem; }
.abs-btn { font-size: .74rem; font-style: italic; border-bottom: 1px solid var(--hair); color: var(--ink2); }
.abs-btn:hover { border-color: var(--ink); }
.abs { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .32s var(--ease); }
.abs > div { overflow: hidden; min-height: 0; }
.abs.open { grid-template-rows: 1fr; }
.abs p { font-size: .78rem; line-height: 1.38; color: var(--ink2); padding-top: .4rem; }
@media (max-width: 760px) { .papers { grid-template-columns: 1fr; } .paper-col, .paper-col:nth-child(odd), .paper-col:nth-child(even) { padding: .7rem 0 0; border-left: 0; } .paper-col:first-child { padding-top: 0; } .paper-col + .paper-col { border-top: 1px solid var(--hair); margin-top: .7rem; } }

/* leisure */
.leisure { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 0 .9rem; align-items: start; }
.leisure figure img { display: block; width: 100%; height: auto; }
.leisure figcaption { font-size: .66rem; color: var(--muted); margin-top: .2rem; font-style: italic; }
.pastimes { list-style: none; font-size: .82rem; line-height: 1.32; }
.pastimes li { padding: .32rem 0; border-top: 1px solid var(--hair); }
.pastimes li:first-child { border-top: 0; padding-top: 0; }
.pastimes strong { font-family: var(--display); font-size: .92rem; }
.pastimes a { text-decoration: none; border-bottom: 1px solid var(--hair); }
.pastimes .act { margin-left: .3rem; font-size: .76rem; font-style: italic; border-bottom: 1px solid var(--hair); color: var(--ink2); white-space: nowrap; }
.pastimes .act:hover { border-color: var(--ink); }
.pastimes output { display: block; font-size: .76rem; font-style: italic; color: var(--muted); white-space: pre; overflow: hidden; text-overflow: ellipsis; font-variant-numeric: tabular-nums; }
.pastimes output:empty { display: none; }
@media (max-width: 420px) { .leisure { grid-template-columns: 1fr; } .leisure figure { max-width: 14rem; margin-bottom: .6rem; } }
.orgs { list-style: none; font-size: .82rem; line-height: 1.3; }
.orgs li { border-top: 1px solid var(--hair); }
.orgs li:first-child { border-top: 0; }
.orgs a { display: grid; grid-template-columns: 1.9rem minmax(0, 1fr); gap: .55rem; align-items: center; padding: .38rem 0; text-decoration: none; }
.orgs .logo { width: 1.9rem; height: 1.9rem; transition: transform .35s cubic-bezier(.34,1.4,.64,1); }
.orgs .logo svg { display: block; width: 100%; height: 100%; }
.orgs a:hover .logo { transform: rotate(-6deg) scale(1.05); }
.orgs strong { font-family: var(--display); }
.orgs a:hover strong { text-decoration: underline; text-underline-offset: 2px; }
.orgs span { display: block; color: var(--muted); font-size: .74rem; }
.art { list-style: none; }
.art li { border-top: 1px solid var(--hair); }
.art li:first-child { border-top: 0; }
.art a { display: block; padding: .38rem 0; text-decoration: none; }
.art strong { display: block; font-family: var(--display); font-size: .98rem; line-height: 1.18; }
.art a:hover strong { text-decoration: underline; text-underline-offset: 2px; }
.art span { display: block; font-size: .76rem; color: var(--ink2); margin-top: .1rem; }
.art time { font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }

/* puzzles */
.sudoku figcaption { display: flex; justify-content: space-between; align-items: baseline; font-size: .72rem; margin-bottom: .3rem; }
.sudoku figcaption span { font-size: .6rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.sdgrid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); width: 100%; max-width: 12.5rem; margin: 0 auto; border: 2px solid var(--ink); }
.sd { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border: 1px solid var(--hair); font: 700 1.25rem/1 var(--display); color: var(--pencil); }
.sd:nth-child(4n+2) { border-right: 2px solid var(--ink); }
.sd:nth-child(n+5):nth-child(-n+8) { border-bottom: 2px solid var(--ink); }
.sd.g { background: var(--tint); color: var(--ink); cursor: default; }
.sd:not(.g):hover { background: var(--tint); }
.sdgrid.won .sd { background: var(--ink); color: var(--paper); transition: background .3s calc(var(--i) * 40ms), color .3s calc(var(--i) * 40ms); }
.sd-msg { min-height: 1.3em; margin-top: .35rem; text-align: center; font-size: .74rem; font-style: italic; color: var(--ink2); }
/* classifieds, boxed like the times' private box */
.classifieds { padding: .6rem .8rem .7rem; border: 1px solid var(--rule); outline: 1px solid var(--rule); outline-offset: 2px; margin: 3px; }
.classifieds h4 { font-size: .66rem; letter-spacing: .13em; text-transform: uppercase; border-bottom: 1px solid var(--rule); padding-bottom: .2rem; margin-bottom: .1rem; }
.ad { padding: .4rem 0; border-top: 1px solid var(--hair); font-size: .8rem; line-height: 1.4; color: var(--ink2); }
.ad:nth-of-type(1) { border-top: 0; }
.ad b { color: var(--ink); letter-spacing: .05em; font-size: .72rem; }
.ad a, .ad button { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--hair); }
.ad a:hover, .ad button:hover { border-color: var(--ink); }

/* ── under the last sheet ── */
.colophon { max-width: 62rem; margin: -1rem auto 1rem; padding: 0 .4rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem 1rem; font-size: .8rem; color: var(--ink); }
.colophon span { background: var(--sheet); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur); box-shadow: var(--shadow); border-radius: 999px; padding: .2rem .7rem; }
.colophon button { border-bottom: 1px solid var(--hair); }
.colophon button:hover { border-color: var(--ink); }

/* ── intro: two halves of the fresco collide, then the machine wakes up (as on utku.space) ── */
#intro { display: none; }
html.intro-on body { overflow: hidden; }
html.intro-on #intro { display: block; position: fixed; inset: 0; z-index: 10000; background: #e7e4dc; overflow: hidden; cursor: pointer; transition: opacity .6s ease; }
#intro.out { opacity: 0; pointer-events: none; }
#intro.log-only .intro-scene { display: none; }
#intro.out.fast { transition-duration: .3s; }
.intro-scene { position: absolute; inset: 0; }
.intro-panel { position: absolute; top: 0; bottom: 0; width: 50%; will-change: transform; }
.intro-panel-l { left: 0; transform: translateX(-101%); }
.intro-panel-r { right: 0; transform: translateX(101%); }
.intro-panel img { --iw: max(125vw, 900px); position: absolute; height: auto; max-width: none; top: calc(50% - var(--iw) * .2495); filter: none; }
.intro-panel-l img { width: calc(var(--iw) * .51456); right: calc(var(--iw) * -.03301); }
.intro-panel-r img { width: calc(var(--iw) * .55146); left: calc(var(--iw) * -.03301); }
.intro-spark { position: absolute; left: 50%; top: 50%; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: #fff; opacity: 0; transform: scale(0);
	box-shadow: 0 0 10px 3px #fff, 0 0 34px 12px rgba(255,236,200,.75), 0 0 90px 30px rgba(255,220,170,.35); }
.intro-flash { position: absolute; left: 50%; top: 50%; width: 24px; height: 24px; margin: -12px 0 0 -12px; border-radius: 50%; background: radial-gradient(circle, #fff 0 45%, rgba(255,248,232,0) 70%); opacity: 0; transform: scale(0); pointer-events: none; }
.intro-log { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(90vw, 48rem); margin: 0; white-space: pre-wrap;
	font: 400 clamp(.78rem, 2.4vw, 1rem)/1.9 var(--mono); color: #e9e5db; letter-spacing: .01em; }
.intro-log .dim { color: rgba(233,229,219,.45); }
.intro-log .caret { display: inline-block; width: .6em; height: 1.05em; margin-left: .1em; vertical-align: -.15em; background: #e9e5db; animation: intro-blink .9s steps(1) infinite; }
.intro-skip { position: absolute; left: 50%; bottom: 1.6rem; transform: translateX(-50%); font: italic .72rem/1 var(--serif); letter-spacing: .04em; color: rgba(128,122,112,.75); white-space: nowrap; }
#intro.play { animation: intro-night .01s linear 4.45s forwards; }
#intro.log-only { background: #000; }
#intro.play .intro-panel-l { animation: intro-in-l 3.4s cubic-bezier(.5,0,.25,1) .2s forwards; }
#intro.play .intro-panel-r { animation: intro-in-r 3.4s cubic-bezier(.5,0,.25,1) .2s forwards; }
#intro.play .intro-spark { animation: intro-spark .6s ease-out 3.5s forwards, intro-hide .01s linear 4.45s forwards; }
#intro.play .intro-flash { animation: intro-flash 1.3s cubic-bezier(.4,0,.2,1) 3.95s forwards; }
#intro.play .intro-scene { animation: intro-hide .01s linear 4.45s forwards; }
@keyframes intro-in-l { to { transform: translateX(0); } }
@keyframes intro-in-r { to { transform: translateX(0); } }
@keyframes intro-spark { 0% { opacity: 0; transform: scale(0); } 35% { opacity: 1; transform: scale(1.4); } 60% { transform: scale(.8); } 100% { opacity: 1; transform: scale(1.6); } }
@keyframes intro-flash { 0% { opacity: 1; transform: scale(0); } 45% { opacity: 1; transform: scale(260); } 100% { opacity: 0; transform: scale(300); } }
@keyframes intro-hide { to { opacity: 0; } }
@keyframes intro-night { to { background-color: #000; } }
@keyframes intro-blink { 50% { opacity: 0; } }

/* ── reveal ── */
.reveal { opacity: 0; transform: translateY(16px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
.reveal.visible { opacity: 1; transform: none; }

/* ── toast ── */
.toast { position: fixed; left: 50%; bottom: 2rem; transform: translateX(-50%) translateY(1.5rem); z-index: 450; padding: .5rem 1rem; max-width: min(92vw, 34rem);
	background: var(--ink); color: var(--paper); font-size: .8rem; font-style: italic; text-align: center;
	opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .25s ease, transform .3s cubic-bezier(.34,1.4,.64,1), visibility 0s .3s; }
.toast.show { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); transition: opacity .25s ease, transform .3s cubic-bezier(.34,1.4,.64,1); }

/* ── the wire: a teletype terminal ── */
.term { position: fixed; left: 50%; bottom: 0; z-index: 420; width: min(760px, 100vw); height: min(55vh, 440px); transform: translate(-50%, 100%); visibility: hidden;
	background: color-mix(in srgb, var(--paper) 72%, transparent); backdrop-filter: var(--glass-blur); -webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-edge); border-bottom: 0; border-radius: 16px 16px 0 0; box-shadow: var(--shadow); display: flex; flex-direction: column;
	font-family: var(--mono); font-size: .78rem; color: var(--ink); transition: transform .35s var(--ease), visibility 0s .35s; }
.term.open { transform: translate(-50%, 0); visibility: visible; transition: transform .35s var(--ease); }
.term-h { display: flex; justify-content: space-between; padding: .4rem .9rem; border-bottom: 3px double var(--rule); font-family: var(--serif); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; }
.term-out { flex: 1; overflow-y: auto; padding: .8rem .9rem 0; white-space: pre-wrap; word-break: break-word; line-height: 1.6; }
.term-out .m { color: var(--muted); }
.term-in { display: flex; gap: .5rem; padding: .55rem .9rem .85rem; }
.term-in input { flex: 1; min-width: 0; background: none; border: 0; outline: 0; color: var(--ink); font: inherit; }

/* ── the fly ── */
.fly { position: fixed; left: 0; top: 0; z-index: 410; width: 26px; height: 26px; margin: -13px 0 0 -13px; padding: 0; color: var(--ink); }
.fly svg { width: 100%; height: 100%; display: block; overflow: visible; }
.fly .w { transform-origin: 15px 13px; animation: buzz .06s linear infinite alternate; opacity: .45; }
@keyframes buzz { to { transform: scaleY(.4); } }
.fly.caught svg { animation: squash .6s var(--ease) forwards; }
@keyframes squash { 30% { transform: scale(1.4, .5); } 100% { transform: scale(0); opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
	*, *::before, *::after { animation-duration: .001s !important; animation-iteration-count: 1 !important; transition-duration: .001s !important; transition-delay: 0s !important; }
	.reveal { opacity: 1; transform: none; }
}
/* ── print: one sheet per page, like the times ── */
@page { size: A4; margin: 8mm; }
@media print {
	[data-theme] { --paper: #fff; --ink: #121212; --ink2: #333; --muted: #6b6860; --rule: #121212; --hair: rgba(18,18,18,.22); --tint: rgba(18,18,18,.06); --pencil: #1f3a8a; --img-filter: none; }
	html, body { background: #fff; }
	html { font-size: 11px; }
	#intro, .page-bg, .bar, .colophon, .toast, .term, .fly, .tl-wrap, .abs-btn, .pastimes .act, .pastimes output { display: none !important; }
	.wrap { padding: 0; }
	.sheet { box-shadow: none; max-width: none; margin: 0; padding: 0; background: #fff; border-radius: 0; backdrop-filter: none; -webkit-backdrop-filter: none; page-break-after: always; break-after: page; animation: none; }
	.sheet::before, .sheet::after { display: none; }
	.sheet:last-of-type { page-break-after: auto; break-after: auto; }
	.reveal { opacity: 1 !important; transform: none !important; }
}
	</style>
</head>
