<script is:inline>
/* ── intro: the touch → spark → boot log → the paper (once per visit), as on utku.space ── */
(function () {
	const html = document.documentElement;
	const root = document.getElementById('intro');
	if (!root || !html.classList.contains('intro-on')) { if (root) root.remove(); return; }
	try { sessionStorage.setItem('introSeen', '1'); } catch (e) {}
	const log = root.querySelector('.intro-log');
	if (matchMedia('(hover: none)').matches) root.querySelector('.intro-skip').textContent = 'tap to skip';
	const timers = [];
	const later = (fn, ms) => timers.push(setTimeout(fn, ms));
	let done = false;
	function finish(fast) {
		if (done) return;
		done = true;
		timers.forEach(clearTimeout);
		removeEventListener('keydown', skip, true);
		root.classList.add('out');
		if (fast) root.classList.add('fast');
		setTimeout(() => { html.classList.remove('intro-on'); root.remove(); }, fast ? 320 : 650);
	}
	function skip(e) { e.preventDefault(); e.stopImmediatePropagation(); finish(true); }   // keep 'd' and '/' from firing underneath
	addEventListener('keydown', skip, true);
	root.addEventListener('pointerdown', () => finish(true));
	root.addEventListener('wheel', (e) => { if (Math.abs(e.deltaY) > 40) finish(true); }, { passive: true });
	// the boot log: "~" marks a dim ellipsis beat
	const LINES = ['> initializing kernel~', '> loading model: utku-quantized-gguf~ ok', '> calibrating curiosity~ ok', '> i think, therefore\u2014'];
	function type(lineIdx) {
		if (done) return;
		if (lineIdx >= LINES.length) { log.insertAdjacentHTML('beforeend', '<span class="caret"></span>'); later(() => finish(false), 1000); return; }
		const text = LINES[lineIdx];
		let i = 0;
		const line = document.createElement('span');
		log.appendChild(line);
		(function step() {
			if (done) return;
			if (i >= text.length) { log.appendChild(document.createTextNode('\n')); later(() => type(lineIdx + 1), 110); return; }
			const ch = text[i++];
			if (ch === '~') { const d = document.createElement('span'); d.className = 'dim'; d.textContent = ' \u2026'; line.appendChild(d); later(step, 220); }
			else { line.appendChild(document.createTextNode(ch)); later(step, 20); }
		})();
	}
	function play() { if (done || root.classList.contains('play')) return; root.classList.add('play'); later(() => type(0), 5300); }
	// if the fresco can't load, skip the scene and go straight to the boot log
	function logOnly() {
		if (done || root.classList.contains('play') || root.classList.contains('log-only')) return;
		root.classList.add('log-only');
		later(() => type(0), 250);
	}
	const imgs = [...root.querySelectorAll('img[data-src]')];
	let pending = imgs.length;
	imgs.forEach((img) => {
		img.addEventListener('load', () => { if (--pending === 0) play(); }, { once: true });
		img.addEventListener('error', logOnly, { once: true });
		img.src = img.dataset.src;
	});
	later(() => { pending > 0 ? logOnly() : play(); }, 2500);
})();
</script>

<script type="application/json" id="cvData" set:html={json}></script>
<script is:inline>
(function () {
	const $ = (s, r) => (r || document).querySelector(s);
	const $$ = (s, r) => [...(r || document).querySelectorAll(s)];
	const data = JSON.parse($('#cvData').textContent);
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const store = { get(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch (e) {} } };
	const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

	/* ── toast ── */
	const toastEl = $('#toast'); let toastT = 0;
	function toast(msg, ms) { toastEl.textContent = msg; toastEl.classList.add('show'); clearTimeout(toastT); toastT = setTimeout(() => toastEl.classList.remove('show'), ms || 2600); }

	/* ── easter eggs, remembered per browser ── */
	const EGGS = { terminal: 'opened the wire', fly: 'caught the fly', konami: 'konami code', sudoku: 'solved the sudoku', lift: 'hit a PR', un: 'took the “un” off', hire: 'answered the ad', end: 'read to the last page' };
	const TOTAL = Object.keys(EGGS).length;
	const found = new Set((store.get('cvEggs') || '').split(',').filter((k) => k in EGGS));
	const paintEggs = () => { $('#eggs').textContent = 'Easter eggs found: ' + found.size + ' / ' + TOTAL + (found.size === TOTAL ? '. All of them.' : ''); };
	function egg(k) {
		if (found.has(k)) return false;
		found.add(k); store.set('cvEggs', [...found].join(',')); paintEggs();
		setTimeout(() => toast('Easter egg ' + found.size + ' / ' + TOTAL + ': ' + EGGS[k] + (found.size === TOTAL ? '. All of them.' : '.')), 350);
		return true;
	}
	paintEggs();

	/* ── day and night editions ── */
	const html = document.documentElement;
	// light by default and the same storage key as utku.space, so the fresco shows as it does there
	const setTheme = (t, keep) => {
		html.setAttribute('data-theme', t);
		$('#themeColor').setAttribute('content', t === 'dark' ? '#111110' : '#fbfaf6');
		if (keep !== false) store.set('theme', t);
	};
	setTheme(html.getAttribute('data-theme') === 'dark' ? 'dark' : 'light', false);
	const flip = () => setTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
	$('#lamp').addEventListener('click', flip);
	$('#printBtn').addEventListener('click', () => print());

	/* ── the edition: volume is the age, number is the day of it, the date is today in ankara ── */
	const bday = (y) => Date.UTC(y, 10, 29) - (y <= 2015 ? 2 : 3) * 3600e3;   // utc+2 in winter until 2016, utc+3 since
	function age(now) {
		let y = new Date(now).getUTCFullYear(), last = bday(y);
		if (now < last) last = bday(--y);
		return (y - 2008) + (now - last) / (bday(y + 1) - last);
	}
	const lastBday = (now) => { let y = new Date(now).getUTCFullYear(); return now < bday(y) ? bday(y - 1) : bday(y); };
	const roman = (n) => [[10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']].reduce((s, [v, r]) => { while (n >= v) { s += r; n -= v; } return s; }, '');
	(function edition() {
		const now = Date.now(), a = age(now);
		$('#vol').textContent = roman(Math.floor(a));
		$('#no').textContent = Math.floor((now - lastBday(now)) / 864e5) + 1;
		const d = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Istanbul', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }).format(now);
		$('#date').textContent = d; $$('.date-2').forEach((e) => { e.textContent = d; });
		$('#idxDev').textContent = new Date(now).getFullYear() - data.codingSince;
	})();
	const ist = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Istanbul', day: '2-digit', month: '2-digit' }).format(new Date());
	if (ist === '29/11') setTimeout(() => toast('It’s his birthday today. Impeccable timing.', 5000), 3000);

	/* ── live age, nine decimals, every frame ── */
	const idxAge = $('#idxAge');
	(function tick() { idxAge.textContent = age(Date.now()).toFixed(9); requestAnimationFrame(tick); })();

	/* ── the “un” comes off, the word is struck, then it snaps back ── */
	$$('.un').forEach((b) => b.addEventListener('click', () => {
		const w = b.closest('.word'); if (w.classList.contains('off')) return;
		w.classList.add('off');
		toast({ predictable: 'Predictable? No.', satisfied: 'Satisfied? Not yet.', conventional: 'Conventional? Never.' }[b.dataset.w]);
		egg('un');
		setTimeout(() => w.classList.remove('off'), 1500);
	}));

	/* ── reveal, the last page ── */
	const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { io.unobserve(e.target); e.target.classList.add('visible'); } }), { threshold: 0.04 });
	$$('.reveal').forEach((el) => io.observe(el));
	new IntersectionObserver((es, o) => es.forEach((e) => { if (e.isIntersecting) { o.disconnect(); setTimeout(() => egg('end'), 600); } }), { threshold: 1 }).observe($('#lastFolio'));

	/* ── a life in years ── */
	const axis = $('#tlAxis'), ticks = $$('.tl-tick', axis), tlYear = $('#tlYear'), tlAge = $('#tlAge'), tlList = $('#tlList');
	let cy = data.last;
	function ageLine(y) {
		if (y === 2008) return 'Day one.';
		const now = Date.now(), thisYear = new Date(now).getUTCFullYear();
		if (y === thisYear && now < bday(y)) return 'Aged ' + (y - 2009) + '; ' + (y - 2008) + ' on 29 November.';
		return 'Aged ' + (y - 2009) + '–' + (y - 2008) + '.';
	}
	const quiet = (y) => y < 2016 ? 'Nothing on record. Too young for a keyboard, allegedly.' : 'Nothing on record this year.';
	function showYear(y) {
		y = Math.max(data.first, Math.min(data.last, y));
		if (y === cy && tlList.childElementCount) return;
		cy = y;
		ticks.forEach((t) => t.classList.toggle('on', +t.dataset.y === y));
		axis.setAttribute('aria-valuenow', y);
		tlYear.textContent = y; tlYear.classList.remove('flip'); void tlYear.offsetWidth; tlYear.classList.add('flip');
		tlAge.textContent = ageLine(y);
		const items = data.record[y];
		tlList.innerHTML = items ? items.map((it, k) => '<li style="--k:' + k + '">' + esc(it) + '</li>').join('') : '<li class="quiet" style="--k:0">' + quiet(y) + '</li>';
	}
	tlAge.textContent = ageLine(cy);
	const yearAt = (x) => { const r = axis.getBoundingClientRect(); return data.first + Math.min(ticks.length - 1, Math.max(0, Math.floor((x - r.left) / r.width * ticks.length))); };
	let dragging = false;
	axis.addEventListener('pointermove', (e) => { if (e.pointerType === 'mouse' || dragging) showYear(yearAt(e.clientX)); });
	axis.addEventListener('pointerdown', (e) => { dragging = true; axis.setPointerCapture(e.pointerId); showYear(yearAt(e.clientX)); });
	axis.addEventListener('pointerup', () => { dragging = false; });
	axis.addEventListener('pointercancel', () => { dragging = false; });
	axis.addEventListener('keydown', (e) => {
		const d = { ArrowLeft: -1, ArrowDown: -1, ArrowRight: 1, ArrowUp: 1 }[e.key];
		if (d) { e.preventDefault(); e.stopPropagation(); showYear(cy + d); }
		if (e.key === 'Home') { e.preventDefault(); showYear(data.first); }
		if (e.key === 'End') { e.preventDefault(); showYear(data.last); }
	});

	/* ── abstracts ── */
	$$('[data-abs]').forEach((b) => b.addEventListener('click', () => {
		const box = document.getElementById(b.dataset.abs), open = box.classList.toggle('open');
		b.setAttribute('aria-expanded', String(open)); b.textContent = open ? 'close the abstract' : 'read the abstract';
	}));

	/* ── classifieds ── */
	$('#mail').addEventListener('click', async () => {
		try { await navigator.clipboard.writeText(data.email); $('#mailHint').textContent = '(copied)'; toast('Email copied. Talk soon.'); }
		catch (e) { location.href = 'mailto:' + data.email; }
		setTimeout(() => { $('#mailHint').textContent = '(click to copy)'; }, 2200);
	});
	$('#reply').addEventListener('click', () => { egg('hire'); location.href = 'mailto:' + data.email + '?subject=' + encodeURIComponent('Re: your ad in The Utku Times'); });

	/* ── sports & leisure ── */
	let plates = 0;
	$('#lift').addEventListener('click', () => {
		const out = $('#liftOut');
		if (plates >= 5) { plates = 0; out.textContent = ''; $('#lift').textContent = 'load the bar'; return; }
		plates++;
		const side = '▮'.repeat(plates);
		out.textContent = side + '━━━━━━' + side + (plates === 5 ? '  five a side. locked out. PR.' : '  ' + plates + ' plate' + (plates > 1 ? 's' : '') + ' a side');
		if (plates === 5) { $('#lift').textContent = 'rack it'; if (!egg('lift')) toast('Another PR. The bar is getting nervous.'); }
	});
	const FILES = 'abcdefgh'; let kx = 6, ky = 0, hops = 0;
	$('#chess').addEventListener('click', () => {
		const moves = [[1,2],[2,1],[-1,2],[-2,1],[1,-2],[2,-1],[-1,-2],[-2,-1]].map(([a, b]) => [kx + a, ky + b]).filter(([a, b]) => a >= 0 && a < 8 && b >= 0 && b < 8);
		const from = FILES[kx] + (ky + 1); [kx, ky] = moves[(Math.random() * moves.length) | 0]; hops++;
		$('#chessOut').textContent = 'N' + from + '–' + FILES[kx] + (ky + 1) + (hops >= 8 ? '  ' + hops + ' moves. Basically a tour.' : '');
	});
	let cups = +(store.get('cvCups') || 0);
	const paintCups = () => { $('#coffeeOut').textContent = cups ? 'Cups poured: ' + cups : ''; };
	paintCups();
	$('#coffee').addEventListener('click', () => { cups++; store.set('cvCups', cups); paintCups(); if (cups % 5 === 0) toast(cups + ' cups. Same, honestly.'); });

	/* ── the 4×4 sudoku ── */
	const GIVEN = [1,0,0,4, 0,4,0,0, 0,0,4,0, 4,0,0,1];
	const sdk = $('#sdk'), sdkMsg = $('#sdkMsg');
	let cells = GIVEN.slice();
	sdk.innerHTML = cells.map((v, i) => '<button type="button" role="gridcell" style="--i:' + i + '" class="sd' + (GIVEN[i] ? ' g' : '') + '" data-i="' + i + '"' + (GIVEN[i] ? ' disabled' : '') + ' aria-label="cell ' + (i + 1) + '">' + (v || '') + '</button>').join('');
	function solved() {
		const g = [];
		for (let r = 0; r < 4; r++) g.push([0,1,2,3].map((c) => cells[r * 4 + c]));
		for (let c = 0; c < 4; c++) g.push([0,1,2,3].map((r) => cells[r * 4 + c]));
		for (const [r0, c0] of [[0,0],[0,2],[2,0],[2,2]]) g.push([0,1,2,3].map((k) => cells[(r0 + (k >> 1)) * 4 + c0 + (k & 1)]));
		return g.every((x) => new Set(x).size === 4 && !x.includes(0));
	}
	sdk.addEventListener('click', (e) => {
		const b = e.target.closest('.sd'); if (!b || b.classList.contains('g')) return;
		if (sdk.classList.contains('won')) { cells = GIVEN.slice(); sdk.classList.remove('won'); $$('.sd', sdk).forEach((c, i) => { c.textContent = cells[i] || ''; }); sdkMsg.textContent = 'Every row, column and box holds 1 to 4.'; return; }
		const i = +b.dataset.i; cells[i] = (cells[i] + 1) % 5; b.textContent = cells[i] || '';
		if (solved()) { sdk.classList.add('won'); sdkMsg.textContent = 'Solved. Faster than reading a CV.'; egg('sudoku'); }
	});

	/* ── the fruit fly: drifts in now and then, dodges the cursor ── */
	const FLY = '<svg viewBox="0 0 30 30"><ellipse class="w" cx="9" cy="10" rx="7" ry="4" fill="currentColor" transform="rotate(-25 9 10)"/><ellipse class="w" cx="21" cy="10" rx="7" ry="4" fill="currentColor" transform="rotate(25 21 10)"/><ellipse cx="15" cy="17" rx="4.2" ry="7" fill="currentColor"/><circle cx="15" cy="9" r="3.4" fill="currentColor"/></svg>';
	let flyEl = null, flyTimer = 0; const mouse = { x: -999, y: -999 };
	addEventListener('pointermove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
	function spawnFly() {
		if (flyEl || document.hidden) return schedFly();
		flyEl = document.createElement('button'); flyEl.className = 'fly'; flyEl.type = 'button'; flyEl.setAttribute('aria-label', 'a fruit fly. catch it.'); flyEl.innerHTML = FLY;
		document.body.appendChild(flyEl);
		const fromLeft = Math.random() < 0.5, t0 = performance.now();
		let x = fromLeft ? -30 : innerWidth + 30, y = innerHeight * (0.25 + Math.random() * 0.5), vx = 0, vy = 0, tx = innerWidth / 2, ty = y, nextT = 0, leaving = false, raf = 0;
		flyEl.addEventListener('click', () => {
			cancelAnimationFrame(raf); flyEl.classList.add('caught'); const was = flyEl; flyEl = null; setTimeout(() => was.remove(), 650);
			if (!egg('fly')) toast('Caught another one.');
			schedFly();
		});
		(function step(t) {
			if (!flyEl) return;
			if (t > nextT) { tx = 40 + Math.random() * (innerWidth - 80); ty = 80 + Math.random() * (innerHeight - 160); nextT = t + 500 + Math.random() * 900; }
			if (t - t0 > 14000 && !leaving) { leaving = true; tx = fromLeft ? innerWidth + 80 : -80; nextT = Infinity; }
			const dx = x - mouse.x, dy = y - mouse.y, d = Math.hypot(dx, dy);
			if (d < 110 && d > 0) { vx += dx / d * 1.6; vy += dy / d * 1.6; }
			vx += (tx - x) * 0.0028 + (Math.random() - 0.5) * 1.4; vy += (ty - y) * 0.0028 + (Math.random() - 0.5) * 1.4;
			vx *= 0.9; vy *= 0.9; x += vx; y += vy;
			flyEl.style.transform = 'translate(' + x + 'px,' + y + 'px) rotate(' + (Math.atan2(vy, vx) * 57.3 + 90) + 'deg)';
			if (leaving && (x < -60 || x > innerWidth + 60)) { flyEl.remove(); flyEl = null; return schedFly(); }
			raf = requestAnimationFrame(step);
		})(t0);
	}
	function schedFly(ms) { clearTimeout(flyTimer); if (reduce && ms === undefined) return; flyTimer = setTimeout(spawnFly, ms !== undefined ? ms : 45000 + Math.random() * 35000); }
	if (!reduce) schedFly(25000);

	/* ── the wire ── */
	const term = $('#term'), out = $('#termOut'), inp = $('#termIn'); const hist = []; let hi = 0;
	const say = (h) => { const d = document.createElement('div'); d.innerHTML = h; out.appendChild(d); out.scrollTop = out.scrollHeight; };
	function openTerm() { term.classList.add('open'); term.setAttribute('aria-hidden', 'false'); if (!out.childElementCount) say('<span class="m">The wire is open. Type help. Esc to close.</span>\n'); setTimeout(() => inp.focus(), 50); egg('terminal'); }
	function closeTerm() { term.classList.remove('open'); term.setAttribute('aria-hidden', 'true'); inp.blur(); }
	$('#termBtn').addEventListener('click', openTerm);
	$('#termX').addEventListener('click', closeTerm);
	const bar = (v, max) => '█'.repeat(Math.round(v / max * 20)).padEnd(20, '░');
	const CMDS = {
		help: () => 'whoami · age · index · sat · gpa · ap · projects · open &lt;name&gt; · papers · honours · year &lt;yyyy&gt; · contact · coffee · lift · fly · eggs · hire · date · clear · exit',
		whoami: () => 'Mehmet Utku Öztürk. Machine learning developer and AI researcher, Ankara.\nUnpredictable, unsatisfied, unconventional.',
		age: () => age(Date.now()).toFixed(12) + ' years. Still compiling.',
		index: () => ['AGE              ' + age(Date.now()).toFixed(9) + '  ▲ live', 'YEARS CODING     ' + (new Date().getFullYear() - data.codingSince) + '         ▲ since 2016', 'GPA (UNW)        4.00      ★', 'SAT MATH         ' + data.sat.math + '       ★', 'SAT R&amp;W          ' + data.sat.rw, 'AP CALC AB/BC    5 / 5     ★', 'AP CSP / CSA     5 / 5     ★', 'PAPERS           ' + data.papers_.length].join('\n'),
		sat: () => 'math                ' + bar(data.sat.math, 800) + ' ' + data.sat.math + '\nreading &amp; writing ' + bar(data.sat.rw, 800) + ' ' + data.sat.rw,
		gpa: () => data.gpa + '.',
		ap: () => Object.entries(data.ap).map(([k, v]) => ('ap ' + k).padEnd(22) + v).join('\n'),
		projects: () => data.projects.map((p) => (p.status === 'active' ? '■' : p.status === 'paused' ? '□' : '<span class="m">■</span>') + ' ' + esc(p.name).padEnd(24) + '<span class="m">' + esc(p.category) + ' · ' + esc(p.role) + '</span>').join('\n') + '\n<span class="m">try: open flydoom</span>',
		open: (a) => {
			const p = data.projects.find((p) => p.name.toLowerCase().startsWith((a || '').toLowerCase()));
			if (!a || !p) return 'open what? try: open flydoom';
			if (!p.link) return esc(p.name) + ' has no public link. It’s ' + esc(p.status) + '.';
			window.open(p.link, '_blank', 'noopener'); return 'opening ' + esc(p.name) + ' ↗';
		},
		papers: () => data.papers_.map((p) => p.year + '  ' + esc(p.name) + '\n      <span class="m">' + esc(p.venue) + '</span>' + (p.link ? '  <a href="' + esc(p.link) + '" target="_blank" rel="noopener">link ↗</a>' : '')).join('\n'),
		honours: () => data.honours.map(esc).join('\n'),
		year: (a) => {
			const y = parseInt(a, 10);
			if (!(y >= data.first && y <= data.last)) return 'year: pick one between ' + data.first + ' and ' + data.last + '.';
			showYear(y); axis.scrollIntoView({ block: 'center' });
			return (data.record[y] || [quiet(y)]).map(esc).join('\n');
		},
		contact: () => '<a href="mailto:' + data.email + '">' + data.email + '</a> · github.com/mutkuoz · linkedin.com/in/mutkuoz',
		coffee: () => { $('#coffee').click(); return 'Poured. Cup #' + cups + '.'; },
		lift: () => { if (plates >= 5) $('#lift').click(); while (plates < 5) $('#lift').click(); return 'Five plates a side. Locked out.'; },
		fly: () => { if (flyEl) return 'It’s already out. Look around.'; spawnFly(); return 'Released one Drosophila melanogaster.'; },
		eggs: () => Object.keys(EGGS).map((k) => (found.has(k) ? '✓ ' + EGGS[k] : '<span class="m">· ???</span>')).join('\n') + '\n' + found.size + ' / ' + TOTAL,
		hire: () => { egg('hire'); return 'Noted. The official channel: <a href="mailto:' + data.email + '?subject=hello%20from%20your%20cv">' + data.email + '</a>'; },
		sudo: (a) => /hire/.test(a || '') ? CMDS.hire() : 'sudo: nice try.',
		konami: () => '↑ ↑ ↓ ↓ ← → ← → b a. Not in here, on the page.',
		date: () => new Date().toString(),
		echo: (a) => esc(a || ''),
		rm: () => 'rm: no. Unconventional, not reckless.',
		clear: () => { out.innerHTML = ''; return null; },
		exit: () => { closeTerm(); return null; }
	};
	inp.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') return closeTerm();
		if (e.key === 'ArrowUp') { if (hi > 0) inp.value = hist[--hi]; e.preventDefault(); return; }
		if (e.key === 'ArrowDown') { if (hi < hist.length - 1) inp.value = hist[++hi]; else { hi = hist.length; inp.value = ''; } e.preventDefault(); return; }
		if (e.key !== 'Enter') return;
		const raw = inp.value.trim(); inp.value = ''; if (!raw) return;
		hist.push(raw); hi = hist.length; say('<span class="m">$</span> ' + esc(raw));
		const [cmd, ...rest] = raw.split(/\s+/), fn = Object.prototype.hasOwnProperty.call(CMDS, cmd.toLowerCase()) && CMDS[cmd.toLowerCase()];
		const res = fn ? fn(rest.join(' ')) : esc(cmd) + ': not found. Try help.';
		if (res !== null) say(res + '\n');
	});

	/* ── keys: d for the lights, / for the wire, the konami code ── */
	const KONAMI = ['arrowup','arrowup','arrowdown','arrowdown','arrowleft','arrowright','arrowleft','arrowright','b','a']; let kp = 0;
	addEventListener('keydown', (e) => {
		const t = e.target, typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
		if (e.key === 'Escape' && !typing) closeTerm();
		if (typing || e.metaKey || e.ctrlKey || e.altKey) return;
		const k = e.key.toLowerCase();
		if (k === KONAMI[kp]) kp++; else if (k !== 'arrowup' || kp !== 2) kp = k === KONAMI[0] ? 1 : 0;
		if (kp === KONAMI.length) {
			kp = 0;
			const on = !html.hasAttribute('data-konami');
			html.toggleAttribute('data-konami', on);
			toast(on ? '↑↑↓↓←→←→ B A. Printed in red.' : 'Back to black ink.'); egg('konami');
			return;
		}
		if (k === 'd' && kp === 0) flip();
		if (e.key === '/' || e.key === '`') { e.preventDefault(); openTerm(); }
	});

	/* ── the glass catches the light where the pointer is ── */
	if (!reduce && matchMedia('(hover: hover) and (pointer: fine)').matches) {
		let target = null, px = 0, py = 0, raf = 0;
		const sheets = $$('.sheet');
		addEventListener('pointermove', (e) => {
			px = e.clientX; py = e.clientY;
			if (raf) return;
			raf = requestAnimationFrame(() => {
				raf = 0;
				target = sheets.find((sh) => { const r = sh.getBoundingClientRect(); return py >= r.top && py <= r.bottom; }) || null;
				if (!target) return;
				const r = target.getBoundingClientRect();
				target.style.setProperty('--mx', ((px - r.left) / r.width * 100).toFixed(1) + '%');
				target.style.setProperty('--my', (py - r.top) + 'px');
			});
		}, { passive: true });
	}

	/* ── leaving the tab ── */
	const title0 = document.title;
	document.addEventListener('visibilitychange', () => { document.title = document.hidden ? 'Stop the presses. Come back.' : title0; });

	/* ── for the ones who open devtools ── */
	console.log('%cThe Utku Times', 'font: 700 28px UnifrakturCook, Georgia, serif');
	console.log('%cYou opened devtools on a CV. Good instinct.\ntry: utku.hire()', 'font: 13px ui-monospace, monospace; color: #888');
	window.utku = { hire() { egg('hire'); return 'Noted. Now email m@utku.space and make it official.'; }, age() { return age(Date.now()); } };
})();
</script>

<script is:inline>
/* ── music player: youtube iframe api, loaded on first hover or play (same engine as utku.space) ── */
(function () {
	const TRACKS = [
		{ id: 'JYuyWrkwpok', title: 'Fly Me to the Moon', artist: 'Frank Sinatra' },
		{ id: 'Rbm6GXllBiw', title: 'Paradise City', artist: 'Guns N’ Roses' },
		{ id: 'fJ9rUzIMcZQ', title: 'Bohemian Rhapsody', artist: 'Queen' },
		{ id: 'KrZHPOeOxQQ', title: 'You Give Love a Bad Name', artist: 'Bon Jovi' },
		{ id: '9n-hyA2-FDg', title: 'La Vie en Rose', artist: 'Louis Armstrong' },
		{ id: 'echO1rg4E08', title: 'Kızılcıklar Oldu mu', artist: 'Kübra Şenyaylar' }
	];
	const root = document.getElementById('player');
	if (!root) return;
	const playBtn = document.getElementById('playerPlay');
	const muteBtn = document.getElementById('playerMute');
	const titleEl = root.querySelector('.player-title');
	const artistEl = root.querySelector('.player-artist');
	const wedge = document.getElementById('playerWedge');
	const vol = document.getElementById('playerVol');
	let i = 0, yt = null, ready = false, loading = false, wantPlay = false, muted = false;
	let fails = 0, gaveUp = false;   // youtube refusals in a row; stop once every track has been refused

	function paint() { titleEl.textContent = titleEl.title = TRACKS[i].title; artistEl.textContent = TRACKS[i].artist; }
	function setPlaying(on) { root.classList.toggle('playing', on); playBtn.setAttribute('aria-label', on ? 'pause' : 'play'); }
	function applyVolume() {
		wedge.style.setProperty('--v', vol.value + '%');
		root.classList.toggle('muted', muted || +vol.value === 0);
		muteBtn.setAttribute('aria-label', muted ? 'unmute' : 'mute');
		if (!ready) return;
		yt.setVolume(+vol.value);
		muted ? yt.mute() : yt.unMute();
	}
	function load() {
		if (loading) return;
		loading = true;
		const prev = window.onYouTubeIframeAPIReady;
		window.onYouTubeIframeAPIReady = function () {
			if (prev) prev();
			yt = new YT.Player('playerYT', {
				width: 200, height: 200, videoId: TRACKS[i].id,
				// no autoplay: the player may be created early (on hover), so it only plays when asked
				playerVars: { autoplay: 0, controls: 0, disablekb: 1, playsinline: 1, rel: 0 },
				events: {
					onReady: function () { ready = true; applyVolume(); if (wantPlay) yt.playVideo(); },
					onStateChange: function (e) {
						if (e.data === YT.PlayerState.ENDED) go(1);
						else if (e.data === YT.PlayerState.PLAYING) { fails = 0; setPlaying(true); }
						else if (e.data === YT.PlayerState.PAUSED) setPlaying(false);
					},
					// embedding blocked (101/150) or the video is gone: try the next one, but not forever
					onError: function () {
						if (++fails >= TRACKS.length) return giveUp();
						if (wantPlay) return go(1);
						// refused while only warming up: line up the next track, quietly
						i = (i + 1) % TRACKS.length; paint(); yt.cueVideoById(TRACKS[i].id);
					}
				}
			});
		};
		const s = document.createElement('script');
		s.src = 'https://www.youtube.com/iframe_api';
		document.head.appendChild(s);
	}
	function giveUp() {
		gaveUp = true; wantPlay = false; setPlaying(false);
		titleEl.textContent = titleEl.title = 'Music unavailable';
		artistEl.textContent = 'YouTube refused playback';
	}
	function go(step) {
		i = (i + step + TRACKS.length) % TRACKS.length;
		paint();
		wantPlay = true; setPlaying(true);
		if (ready) yt.loadVideoById(TRACKS[i].id); else load();
	}
	// warm the player up as soon as someone reaches for it, so the click can start
	// playback straight away (browsers only allow sound right after a click)
	root.addEventListener('pointerenter', load, { once: true });
	root.addEventListener('focusin', load, { once: true });
	playBtn.addEventListener('click', function () {
		if (gaveUp) { gaveUp = false; fails = 0; go(0); return; }
		if (!ready) { wantPlay = !wantPlay; setPlaying(wantPlay); load(); return; }
		if (root.classList.contains('playing')) { wantPlay = false; yt.pauseVideo(); setPlaying(false); }
		else { wantPlay = true; yt.playVideo(); setPlaying(true); }
	});
	document.getElementById('playerNext').addEventListener('click', function () { gaveUp = false; fails = 0; go(1); });
	document.getElementById('playerPrev').addEventListener('click', function () { gaveUp = false; fails = 0; go(-1); });
	muteBtn.addEventListener('click', function () { muted = !muted; applyVolume(); });
	vol.addEventListener('input', function () { muted = false; applyVolume(); });
	paint();
})();
</script>
</body>
</html>
